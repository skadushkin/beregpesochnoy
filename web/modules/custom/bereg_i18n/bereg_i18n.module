<?php

/**
 * @file
 * Domain-based English and Arabic copies of Bereg Pesochnoy.
 */

/**
 * Language code for the current host: ru, en, ar.
 */
function bereg_i18n_lang(): string {
  static $lang;
  if ($lang !== NULL) {
    return $lang;
  }
  $host = strtolower(\Drupal::request()->getHost());
  if ($host === 'en.beregpesochnoy.ru' || str_starts_with($host, 'en.')) {
    $lang = 'en';
    return $lang;
  }
  if ($host === 'ae.beregpesochnoy.ru' || str_starts_with($host, 'ae.')) {
    $lang = 'ar';
    return $lang;
  }
  $lang = 'ru';
  return $lang;
}

/**
 * @return array{ru: string, en: string, ar: string}
 */
function bereg_i18n_hosts(): array {
  return [
    'ru' => 'https://beregpesochnoy.ru',
    'en' => 'https://en.beregpesochnoy.ru',
    'ar' => 'https://ae.beregpesochnoy.ru',
  ];
}

function bereg_i18n_translate_string(string $text, ?string $lang = NULL): string {
  $lang = $lang ?? bereg_i18n_lang();
  if ($lang === 'ru' || $text === '') {
    return $text;
  }
  $map = &drupal_static(__FUNCTION__);
  if ($map === NULL) {
    require_once __DIR__ . '/translations/map.php';
    $map = bereg_i18n_dictionary();
  }
  if (isset($map[$text][$lang])) {
    return $map[$text][$lang];
  }
  return $text;
}

function bereg_i18n_translate_html(string $html, ?string $lang = NULL): string {
  $lang = $lang ?? bereg_i18n_lang();
  if ($lang === 'ru' || $html === '') {
    return $html;
  }
  require_once __DIR__ . '/translations/map.php';
  $map = bereg_i18n_dictionary();
  uksort($map, static function (string $a, string $b): int {
    return mb_strlen($b) <=> mb_strlen($a);
  });

  $parts = preg_split('/(<(?:style)[^>]*>.*?<\/(?:style)>)/is', $html, -1, PREG_SPLIT_DELIM_CAPTURE);
  if ($parts === FALSE) {
    return $html;
  }
  $out = '';
  foreach ($parts as $index => $part) {
    if ($index % 2 === 1) {
      $out .= $part;
      continue;
    }
    $part = str_replace(["\u{00A0}", '&nbsp;', '&#160;', '&#xa0;'], ' ', $part);
    $part = preg_replace_callback('/&#x([0-9A-Fa-f]+);/', static function (array $m): string {
      $char = mb_chr(hexdec($m[1]), 'UTF-8');
      return $char === FALSE ? $m[0] : $char;
    }, $part) ?? $part;
    $part = preg_replace_callback('/&#(\d+);/', static function (array $m): string {
      $n = (int) $m[1];
      if (in_array($n, [34, 38, 39, 60, 62], TRUE)) {
        return $m[0];
      }
      $char = mb_chr($n, 'UTF-8');
      return $char === FALSE ? $m[0] : $char;
    }, $part) ?? $part;
    foreach ($map as $ru => $pair) {
      $to = $pair[$lang] ?? '';
      if ($to !== '' && $ru !== $to && str_contains($part, $ru)) {
        $part = bereg_i18n_replace_phrase($part, $ru, $to);
      }
    }
    $out .= $part;
  }
  return $out;
}

function bereg_i18n_replace_phrase(string $haystack, string $ru, string $to): string {
  if (str_contains($ru, '<') || mb_strlen($ru) >= 16) {
    return str_replace($ru, $to, $haystack);
  }
  $replaced = preg_replace(
    '/(?<![\p{L}])' . preg_quote($ru, '/') . '(?![\p{L}])/u',
    $to,
    $haystack
  );
  return is_string($replaced) ? $replaced : $haystack;
}

/**
 * Implements hook_preprocess_html().
 */
function bereg_i18n_preprocess_html(array &$variables): void {
  $lang = bereg_i18n_lang();
  $variables['bereg_lang'] = $lang;
  $variables['bereg_dir'] = $lang === 'ar' ? 'rtl' : 'ltr';
  $variables['html_attributes']['lang'] = $lang === 'ar' ? 'ar' : $lang;
  $variables['html_attributes']['dir'] = $variables['bereg_dir'];
  $variables['attributes']['class'][] = 'lang-' . $lang;
  if ($lang === 'ar') {
    $variables['attributes']['class'][] = 'is-rtl';
  }

  $path = \Drupal::request()->getRequestUri() ?: '/';
  $hosts = bereg_i18n_hosts();
  $variables['bereg_lang_links'] = [];
  foreach ($hosts as $code => $base) {
    $variables['bereg_lang_links'][] = [
      'code' => $code,
      'label' => match ($code) {
        'en' => 'EN',
        'ar' => 'AR',
        default => 'RU',
      },
      'url' => $base . $path,
      'active' => $code === $lang,
    ];
  }

  if (!empty($variables['head_title']) && is_array($variables['head_title'])) {
    foreach ($variables['head_title'] as $key => $value) {
      $variables['head_title'][$key] = bereg_i18n_translate_html((string) $value);
    }
  }

  $variables['#attached']['library'][] = 'bereg_i18n/switcher';
  $variables['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => 'ru',
        'href' => $hosts['ru'] . $path,
      ],
    ],
    'bereg_hreflang_ru',
  ];
  $variables['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => 'en',
        'href' => $hosts['en'] . $path,
      ],
    ],
    'bereg_hreflang_en',
  ];
  $variables['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => 'ar',
        'href' => $hosts['ar'] . $path,
      ],
    ],
    'bereg_hreflang_ar',
  ];
}

/**
 * Implements hook_preprocess_menu().
 */
function bereg_i18n_preprocess_menu(array &$variables): void {
  if (bereg_i18n_lang() === 'ru' || empty($variables['items'])) {
    return;
  }
  bereg_i18n_hide_news_menu_items($variables['items']);
  bereg_i18n_translate_menu_items($variables['items']);
}

/**
 * News is hidden on EN/AR copies until those pages are translated.
 */
function bereg_i18n_hide_news_menu_items(array &$items): void {
  foreach ($items as $key => &$item) {
    if (bereg_i18n_menu_item_is_news($item)) {
      unset($items[$key]);
      continue;
    }
    if (!empty($item['below']) && is_array($item['below'])) {
      bereg_i18n_hide_news_menu_items($item['below']);
    }
  }
}

function bereg_i18n_menu_item_is_news(array $item): bool {
  $title = trim(html_entity_decode(strip_tags((string) ($item['title'] ?? '')), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
  if (in_array($title, ['Новости', 'НОВОСТИ', 'News', 'NEWS', 'أخبار'], TRUE)) {
    return TRUE;
  }
  $url = '';
  if (!empty($item['url']) && is_object($item['url']) && method_exists($item['url'], 'toString')) {
    try {
      $url = (string) $item['url']->toString();
    }
    catch (\Throwable $e) {
      $url = '';
    }
  }
  $path = strtolower((string) (parse_url($url, PHP_URL_PATH) ?: $url));
  return (bool) preg_match('#(^|/)(news|novosti)(/|$)#', $path);
}

/**
 * Implements hook_library_info_alter().
 */
function bereg_i18n_library_info_alter(array &$libraries, $extension): void {
  foreach ($libraries as $id => &$library) {
    if (!is_array($library)) {
      unset($libraries[$id]);
      continue;
    }
    foreach (['js', 'css'] as $type) {
      if (!isset($library[$type]) || $library[$type] === NULL) {
        $library[$type] = [];
      }
    }
    if (is_array($library['css'])) {
      foreach ($library['css'] as $category => $files) {
        if ($files === NULL) {
          $library['css'][$category] = [];
        }
      }
    }
  }
  unset($library);
}

/**
 * Hide prices on EN/AR copies.
 */
function bereg_i18n_hide_prices_html(string $html): string {
  $parts = preg_split('/(<(?:script)[^>]*>.*?<\/(?:script)>)/is', $html, -1, PREG_SPLIT_DELIM_CAPTURE);
  if ($parts === FALSE) {
    return $html;
  }
  $patterns = [
    '~<div class="catalog-item-price">[\s\S]*?</div>\s*</div>~i',
    '~<div class="product-card__price">[\s\S]*?</div>~i',
    '~<div class="tooltip-price-block">[\s\S]*?</div>~i',
    '~<div class="tooltip-price">[\s\S]*?</div>~i',
    '~<div class="popular-project-price">[\s\S]*?</div>~i',
    '~<div class="new-town-price(?:-ipoteka)?">[\s\S]*?</div>~i',
    '~<div class="header-under-ipoteka-price">[\s\S]*?</div>~i',
    '~<div class="product-item-data-price"[^>]*>[\s\S]*?</div>~i',
    '~<div class="second-info-left-item-main-title">[\s\S]*?</div>~i',
  ];
  $out = '';
  foreach ($parts as $index => $part) {
    if ($index % 2 === 1) {
      $out .= $part;
      continue;
    }
    foreach ($patterns as $pattern) {
      $replaced = preg_replace($pattern, '', $part);
      if (is_string($replaced)) {
        $part = $replaced;
      }
    }
    $replaced = preg_replace(
      '~\d{1,3}(?:[ \x{00A0}]\d{3})+(?:\s*(?:₽|&nbsp;₽|р(?:\b|/)|RUB|руб\.?))~u',
      '',
      $part
    );
    if (is_string($replaced)) {
      $part = $replaced;
    }
    $out .= $part;
  }
  return $out;
}

function bereg_i18n_hide_news_html(string $html): string {
  // Use ~ as delimiter: a # delimiter breaks on [/?#"] and yields
  // "Unknown modifier '"'" on Views AJAX / load-more responses.
  $patterns = [
    '~<div class="footer-col-item">\s*<a[^>]+href="[^"]*(?:/news|/novosti)(?:[/?\#"][^"]*)?"[^>]*>.*?</a>\s*</div>~is',
    '~<div class="tap-menu-top-item[^"]*">\s*<a[^>]+href="[^"]*(?:/news|/novosti)(?:[/?\#"][^"]*)?"[^>]*>.*?</a>\s*</div>~is',
    '~<a[^>]+href="[^"]*(?:/news|/novosti)(?:[/?\#"][^"]*)?"[^>]*>.*?</a>~is',
  ];
  foreach ($patterns as $pattern) {
    $replaced = preg_replace($pattern, '', $html);
    if (is_string($replaced)) {
      $html = $replaced;
    }
  }
  return $html;
}

/**
 * Implements hook_metatags_alter().
 */
function bereg_i18n_metatags_alter(array &$metatags, array &$context): void {
  if (bereg_i18n_lang() === 'ru') {
    return;
  }
  foreach ($metatags as $key => $value) {
    if (is_string($value)) {
      $metatags[$key] = bereg_i18n_translate_html($value);
    }
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function bereg_i18n_preprocess_page_title(array &$variables): void {
  if (bereg_i18n_lang() === 'ru' || empty($variables['title'])) {
    return;
  }
  $variables['title'] = bereg_i18n_translate_html((string) $variables['title']);
}

function bereg_i18n_translate_menu_items(array &$items): void {
  foreach ($items as &$item) {
    if (!empty($item['title'])) {
      $item['title'] = bereg_i18n_translate_string((string) $item['title']);
    }
    if (!empty($item['below']) && is_array($item['below'])) {
      bereg_i18n_translate_menu_items($item['below']);
    }
  }
}

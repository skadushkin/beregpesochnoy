  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 969) {
    $page['#attached']['library'][] = 'bootstrap/landing_gaz';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'КП «Берег Песочной» — коттеджный поселок с магистральным газом на Новой Риге, 45 км от МКАД. Газ подведен к границе каждого участка, подключение дома через ГРО, городские коммуникации, охрана и парк 8 га.',
        ],

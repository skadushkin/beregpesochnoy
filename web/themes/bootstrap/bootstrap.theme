  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 511) {
    $page['#attached']['library'][] = 'bootstrap/taunhausy_page_511';
  }
  if (bootstrap_is_node_page(223)) {
    $page['#attached']['library'][] = 'bootstrap/catalog_seo_tags';
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 50) {
    $page['#attached']['library'][] = 'bootstrap/seo_page_50';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Готовые дома с участком в коттеджном поселке «Берег Песочной» на Новой Риге, 45 км от МКАД. Закрытая охраняемая территория, парк 8 га, река Песочная, городские коммуникации и каталог доступных домов. Запишитесь на экскурсию и выберите дом для постоянного проживания.',
        ],
      ],
      'gotovye_doma_seo_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 853) {
    $page['#attached']['library'][] = 'bootstrap/landing_park';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Ландшафтный парк 8 га с прудом, прогулочными дорожками, детскими площадками и зонами отдыха в КП «Берег Песочной». Собственный парк для жителей поселка без выезда за его пределы.',
        ],
      ],
      'park_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 854) {
    $page['#attached']['library'][] = 'bootstrap/landing_infrastructure';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Инфраструктура КП «Берег Песочной»: газ, канализация, охрана, парк, досуговый центр и городской комфорт для постоянного проживания за городом.',
        ],
      ],
      'infra_landing_description',
    ];
  }
  if (bootstrap_is_mfk_page()) {
    $page['#attached']['library'][] = 'bootstrap/landing_mfk';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Многофункциональный комплекс КП «Берег Песочной»: бассейн, детская комната, магазин, кафе, спортзал и другие сервисы для жизни за городом.',
        ],
      ],
      'mfk_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof NodeInterface && $node->bundle() === 'posadochnaya_katalog') {
    $page['#attached']['library'][] = 'bootstrap/posadochnaya_katalog';
    $meta = bootstrap_posadochnaya_field_plain($node, ['field_meta_description', 'field_metatag_description']);
    if ($meta !== '') {
      $page['#attached']['html_head'][] = [
        [
          '#tag' => 'meta',
          '#attributes' => [
            'name' => 'description',
            'content' => $meta,
          ],
        ],
        'posadochnaya_katalog_description',
      ];
    }
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof NodeInterface && $node->bundle() === 'posadochnaya_ponton') {
    $page['#attached']['library'][] = 'bootstrap/posadochnaya_ponton';
    $meta = bootstrap_posadochnaya_field_plain($node, ['field_meta_description', 'field_metatag_description']);
    if ($meta !== '') {
      $page['#attached']['html_head'][] = [
        [
          '#tag' => 'meta',
          '#attributes' => [
            'name' => 'description',
            'content' => $meta,
          ],
        ],
        'posadochnaya_ponton_description',
      ];
    }
  }
  if (\Drupal::service('path.matcher')->isFrontPage() && !bootstrap_is_node_page(838)) {
    $page['#attached']['library'][] = 'bootstrap/genplan_lazy';
  }
  $current_path = \Drupal::service('path.current')->getPath();
  $route_match = \Drupal::service('current_route_match');
  if (\Drupal::currentUser()->hasPermission('access administration pages')) {
    $page['#attached']['library'][] = 'bootstrap/admin-components';
  }
  if (!\Drupal::currentUser()->hasPermission('access administration pages') && !empty($page['#attached']['library'])) {
    $page['#attached']['library'] = array_diff(
      $page['#attached']['library'],
      [
        'system/base',
        'system/admin',
      ]
    );
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function bootstrap_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];
  
  if ($view->id() == 'gotovye_doma' && ($view->current_display == 'block_8' || $view->current_display == 'block_9')) {
    // Используем статическую переменную для подсчета строк
    static $row_counter = 0;
    
   $pattern = [1, 2, 3, 2];
    $block_type = $pattern[$row_counter % count($pattern)];
    
    // Передаем переменные в шаблон
    $variables['block_type'] = $block_type;
    
    // Передаем переменные в шаблон
    $variables['row_number'] = $row_counter + 1;
    $variables['block_type'] = $block_type;
    
    // Увеличиваем счетчик
    $row_counter++;
    
    // Определяем класс и расположение
    if ($block_type == 1) {
      $variables['block_class'] = 'gold-block';
      $variables['image_position'] = 'left';
    } elseif ($block_type == 2) {
      $variables['block_class'] = 'black-block';
      $variables['image_position'] = 'right';
    } else {
      $variables['block_class'] = 'brown-block';
      $variables['image_position'] = 'left';
    }
  }

  if ($view->id() === 'gotovye_doma' && $view->current_display === 'block_6' && bootstrap_is_landing_catalog_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_fields__gotovye_doma__block_6__landing_v2';
  }
  if ($view->id() === 'gotovye_doma' && bootstrap_is_landing_v2_page() && in_array($view->current_display, ['block_3', 'block_4', 'block_5', 'block_6'], TRUE)) {
    $variables['theme_hook_suggestions'][] = 'views_view_fields__gotovye_doma__landing_v2';
  }

  if ($view->id() === 'novyy_slayder1' && bootstrap_is_landing_slider_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_fields__novyy_slayder1';
    if ($view->current_display === 'block_3' && bootstrap_is_landing_v2_page()) {
      $variables['theme_hook_suggestions'][] = 'views_view_fields__novyy_slayder1__block_3';
    }
    if ($view->current_display === 'block_6' && bootstrap_is_mfk_page()) {
      $variables['theme_hook_suggestions'][] = 'views_view_fields__novyy_slayder1__block_6__mfk';
    }
  }
}


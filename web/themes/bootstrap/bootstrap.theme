      'gaz_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 978) {
    $page['#attached']['library'][] = 'bootstrap/landing_prozhivanie';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'КП «Берег Песочной» — коттеджный поселок для постоянного проживания на Новой Риге, 45 км от МКАД. Городские коммуникации, охрана, интернет, парк 8 га и инфраструктура Истры в 10 минутах.',
        ],
      ],
      'prozhivanie_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 980) {
    $page['#attached']['library'][] = 'bootstrap/landing_uk';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Единая служба для жителей КП «Берег Песочной»: уход за участком, электрика, сантехника и бытовые работы. Оставьте заявку — поможем с обслуживанием дома и территории.',
        ],

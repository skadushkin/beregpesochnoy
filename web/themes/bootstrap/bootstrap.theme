      'uk_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 852) {
    $page['#attached']['library'][] = 'bootstrap/seo_page_852';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Дома на Новой Риге в КП «Берег Песочной», 45 км от МКАД. Готовые и строящиеся дома, участки с подрядом, Истринский район, парк 8 га, река Песочная и городские коммуникации. Подберите дом для жизни за городом.',

/**
 * Текущая нода маршрута (если есть).
 */
function bootstrap_get_route_node(): ?NodeInterface {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    return $node;
  }
  if (is_numeric($node)) {
    return Node::load((int) $node);
  }
  return NULL;
}

/**
 * Нода, заданная как главная страница (/admin/config/system/site-information).
 */
function bootstrap_get_front_page_node(): ?NodeInterface {
  $front = (string) \Drupal::config('system.site')->get('page.front');
  if ($front === '' || $front === '/user/login') {
    return NULL;
  }

  $path = $front;
  if ($path[0] !== '/') {
    $path = '/' . $path;
  }

  if (preg_match('#^/node/(\d+)$#', $path, $matches)) {
    return Node::load((int) $matches[1]);
  }

  $system_path = \Drupal::service('path_alias.manager')->getPathByAlias($path);
  if (preg_match('#^/node/(\d+)$#', $system_path, $matches)) {
    return Node::load((int) $matches[1]);
  }

  return NULL;
}

/**
 * Текущая страница — canonical-нода или главная с этой нодой.
 */
function bootstrap_is_node_page(int $nid): bool {
  $node = bootstrap_get_route_node();
  if ($node instanceof NodeInterface && (int) $node->id() === $nid) {
    return TRUE;
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $front = bootstrap_get_front_page_node();
    return $front instanceof NodeInterface && (int) $front->id() === $nid;
  }
  return (bool) preg_match('#/node/' . $nid . '$#', \Drupal::service('path.current')->getPath());
}

/**
 * Первое непустое текстовое поле сущности.
 */
function bootstrap_posadochnaya_field_plain($entity, array $field_names): string {
  foreach ($field_names as $field_name) {
    if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
      continue;
    }
    $item = $entity->get($field_name)->first();
    if ($item && isset($item->value)) {
      return trim(strip_tags((string) $item->value));
    }
  }
  return '';
}

/**
 * Первое непустое форматированное поле сущности.
 */
function bootstrap_posadochnaya_field_markup($entity, array $field_names): string {
  foreach ($field_names as $field_name) {
    if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
      continue;
    }
    $item = $entity->get($field_name)->first();
    if ($item && isset($item->value)) {
      $format = $item->format ?? 'full_html';
      return (string) check_markup($item->value, $format);
    }
  }
  return '';
}

/**
 * URL hero-изображения посадочной страницы.
 */
function bootstrap_posadochnaya_hero_image(NodeInterface $node): ?string {
  $file_url_generator = \Drupal::service('file_url_generator');
  foreach (['field_oblozhka', 'field_hero_image', 'field_kartinka', 'field_image'] as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }
    $file = $node->get($field_name)->entity;
    if ($file) {
      return $file_url_generator->generateAbsoluteString($file->getFileUri());
    }
  }
  return NULL;
}

/**
 * Секции field_teksty для блоков после каталога.
 */
function bootstrap_posadochnaya_get_teksty_sections(NodeInterface $node): array {
  if (!$node->hasField('field_teksty') || $node->get('field_teksty')->isEmpty()) {
    return [];
  }

  $sections = [];
  $field = $node->get('field_teksty');
  $field_type = $field->getFieldDefinition()->getType();

  if ($field_type === 'entity_reference_revisions') {
    foreach ($field as $item) {
      $paragraph = $item->entity;
      if (!$paragraph) {
        continue;
      }
      $title = bootstrap_posadochnaya_field_plain($paragraph, [
        'field_zagolovok',
        'field_title',
        'field_nazvanie',
      ]);
      $text = bootstrap_posadochnaya_field_markup($paragraph, [
        'field_tekst',
        'field_text',
        'field_opisanie',
        'body',
      ]);
      if ($title !== '' || $text !== '') {
        $sections[] = [
          'title' => $title,
          'text' => $text,
        ];
      }
    }
    return $sections;
  }

  foreach ($field as $item) {
    $title = trim((string) ($item->summary ?? ''));
    $text = '';
    if (isset($item->value)) {
      $format = $item->format ?? 'full_html';
      $text = (string) check_markup($item->value, $format);
    }
    if ($title === '' && $text !== '') {
      $title = bootstrap_posadochnaya_field_plain($node, ['field_zagolovok']);
    }
    if ($title !== '' || $text !== '') {
      $sections[] = [
        'title' => $title,
        'text' => $text,
      ];
    }
  }

  return $sections;
}

/**
 * Элементы field_faq для блока вопросов и ответов.
 */
function bootstrap_posadochnaya_get_faq_items(NodeInterface $node): array {
  if (!$node->hasField('field_faq') || $node->get('field_faq')->isEmpty()) {
    return [];
  }

  $items = [];
  $field = $node->get('field_faq');
  $field_type = $field->getFieldDefinition()->getType();

  if ($field_type === 'entity_reference_revisions') {
    foreach ($field as $item) {
      $paragraph = $item->entity;
      if (!$paragraph) {
        continue;
      }
      $question = bootstrap_posadochnaya_field_plain($paragraph, [
        'field_vopros',
        'field_question',
        'field_zagolovok',
        'field_title',
      ]);
      $answer = bootstrap_posadochnaya_field_markup($paragraph, [
        'field_otvet',
        'field_answer',
        'field_tekst',
        'field_text',
        'body',
      ]);
      if ($question !== '' || $answer !== '') {
        $items[] = [
          'question' => $question,
          'answer' => $answer,
        ];
      }
    }
    return $items;
  }

  foreach ($field as $item) {
    $question = trim((string) ($item->summary ?? ''));
    $answer = '';
    if (isset($item->value)) {
      $format = $item->format ?? 'full_html';
      $answer = (string) check_markup($item->value, $format);
    }
    if ($question !== '' || $answer !== '') {
      $items[] = [
        'question' => $question,
        'answer' => $answer,
      ];
    }
  }

  return $items;
}

/**
 * URL изображения в поле сущности.
 */
function bootstrap_posadochnaya_entity_image($entity, array $field_names = ['field_image', 'field_kartinka', 'field_foto', 'field_oblozhka']): ?string {
  $file_url_generator = \Drupal::service('file_url_generator');
  foreach ($field_names as $field_name) {
    if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
      continue;
    }
    $file = $entity->get($field_name)->entity;
    if ($file) {
      return $file_url_generator->generateAbsoluteString($file->getFileUri());
    }
  }
  return NULL;
}

/**
 * Элементы повторяющегося paragraph-поля.
 */
function bootstrap_posadochnaya_get_paragraph_items(NodeInterface $node, array $field_names): array {
  foreach ($field_names as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }
    if ($node->get($field_name)->getFieldDefinition()->getType() !== 'entity_reference_revisions') {
      continue;
    }
    $items = [];
    foreach ($node->get($field_name) as $item) {
      if ($item->entity) {
        $items[] = $item->entity;
      }
    }
    if ($items) {
      return $items;
    }
  }
  return [];
}

/**
 * Статистика hero из paragraph-поля.
 */
function bootstrap_posadochnaya_get_stats(NodeInterface $node): array {
  $stats = [];
  foreach (bootstrap_posadochnaya_get_paragraph_items($node, ['field_statistika', 'field_stats', 'field_stat']) as $paragraph) {
    $value = bootstrap_posadochnaya_field_plain($paragraph, ['field_znachenie', 'field_value', 'field_title', 'field_zagolovok']);
    $label = bootstrap_posadochnaya_field_plain($paragraph, ['field_podpis', 'field_label', 'field_tekst', 'field_text']);
    if ($value !== '' || $label !== '') {
      $stats[] = [
        'value' => $value,
        'label' => $label,
      ];
    }
  }
  return $stats;
}

/**
 * Карточки bento-сетки.
 */
function bootstrap_posadochnaya_get_bento_items(NodeInterface $node): array {
  $slot_aliases = [
    'comfort' => 'comfort',
    'photo_1' => 'photo_1',
    'photo1' => 'photo_1',
    'photo_cafe' => 'photo_cafe',
    'cafe_photo' => 'photo_cafe',
    'cafe' => 'cafe',
    'activity' => 'activity',
    'photo_3' => 'photo_3',
    'photo3' => 'photo_3',
    'sport' => 'photo_3',
  ];
  $slot_order = ['comfort', 'photo_1', 'photo_cafe', 'cafe', 'activity', 'photo_3'];
  $items_by_slot = [];

  foreach (bootstrap_posadochnaya_get_paragraph_items($node, ['field_bento', 'field_bloki_bento', 'field_bloki', 'field_preimushchestva', 'field_kartochki']) as $index => $paragraph) {
    $slot = strtolower(bootstrap_posadochnaya_field_plain($paragraph, ['field_tip', 'field_type', 'field_slot', 'field_klass']));
    $slot = $slot_aliases[$slot] ?? ($slot_order[$index] ?? 'comfort');
    $items_by_slot[$slot] = [
      'slot' => $slot,
      'title' => bootstrap_posadochnaya_field_plain($paragraph, ['field_zagolovok', 'field_title', 'field_nazvanie']),
      'text' => bootstrap_posadochnaya_field_markup($paragraph, ['field_tekst', 'field_text', 'field_opisanie', 'body']),
      'image' => bootstrap_posadochnaya_entity_image($paragraph),
      'is_photo' => str_starts_with($slot, 'photo_'),
    ];
  }

  $items = [];
  foreach ($slot_order as $slot) {
    if (isset($items_by_slot[$slot])) {
      $items[] = $items_by_slot[$slot];
    }
  }
  foreach ($items_by_slot as $slot => $item) {
    if (!in_array($slot, $slot_order, TRUE)) {
      $items[] = $item;
    }
  }

  return $items;
}

/**
 * Элементы lifestyle-мозаики.
 */
function bootstrap_posadochnaya_get_lifestyle_items(NodeInterface $node): array {
  $slot_aliases = [
    'vip' => 'vip',
    'morning' => 'morning',
    'evening' => 'evening',
    'family' => 'family',
    'route' => 'route',
  ];
  $slot_order = ['vip', 'morning', 'evening', 'family', 'route'];
  $items_by_slot = [];

  foreach (bootstrap_posadochnaya_get_paragraph_items($node, ['field_mozaika', 'field_lifestyle', 'field_bloki_mozaika']) as $index => $paragraph) {
    $slot = strtolower(bootstrap_posadochnaya_field_plain($paragraph, ['field_tip', 'field_type', 'field_slot', 'field_klass']));
    $slot = $slot_aliases[$slot] ?? ($slot_order[$index] ?? 'vip');
    $items_by_slot[$slot] = [
      'slot' => $slot,
      'tag' => bootstrap_posadochnaya_field_plain($paragraph, ['field_zagolovok', 'field_title', 'field_nazvanie', 'field_podpis']),
      'image' => bootstrap_posadochnaya_entity_image($paragraph),
    ];
  }

  $items = [];
  foreach ($slot_order as $slot) {
    if (isset($items_by_slot[$slot])) {
      $items[] = $items_by_slot[$slot];
    }
  }
  foreach ($items_by_slot as $slot => $item) {
    if (!in_array($slot, $slot_order, TRUE)) {
      $items[] = $item;
    }
  }

  return $items;
}

/**
 * Данные посадочной страницы для Twig-шаблонов.
 */
function bootstrap_posadochnaya_page_data(NodeInterface $node): array {
  $catalog_type = bootstrap_posadochnaya_field_plain($node, ['field_tip_katalog', 'field_katalog_tip']);
  $catalog_display = $catalog_type === 'gotovye' ? 'block_1' : 'block_6';
  $slider_display = bootstrap_posadochnaya_field_plain($node, [
    'field_slajder_display',
    'field_slajder_blok',
    'field_slajder',
  ]);

  return [
    'title' => $node->label(),
    'subtitle' => bootstrap_posadochnaya_field_plain($node, ['field_zagolovok', 'field_podzagolovok']),
    'intro' => bootstrap_posadochnaya_field_markup($node, ['body']),
    'hero_image' => bootstrap_posadochnaya_hero_image($node),
    'stats' => bootstrap_posadochnaya_get_stats($node),
    'about_title' => bootstrap_posadochnaya_field_plain($node, [
      'field_zagolovok_o',
      'field_bento_zagolovok',
      'field_zagolovok_bento',
      'field_o_zagolovok',
      'field_zagolovok_sekcii',
      'field_zagolovok_bloka',
    ]),
    'about_text' => bootstrap_posadochnaya_field_markup($node, [
      'field_tekst_o',
      'field_bento_tekst',
      'field_o_tekst',
      'field_opisanie_o',
      'field_opisanie',
      'field_anons',
      'field_tekst_sekcii',
    ]),
    'bento' => bootstrap_posadochnaya_get_bento_items($node),
    'slider_title' => bootstrap_posadochnaya_field_plain($node, [
      'field_slajder_zagolovok',
      'field_zagolovok_slajder',
    ]),
    'slider_display' => $slider_display !== '' ? $slider_display : 'block_2',
    'lifestyle_title' => bootstrap_posadochnaya_field_plain($node, [
      'field_mozaika_zagolovok',
      'field_zagolovok_mozaika',
    ]),
    'lifestyle_items' => bootstrap_posadochnaya_get_lifestyle_items($node),
    'teksty' => bootstrap_posadochnaya_get_teksty_sections($node),
    'faq' => bootstrap_posadochnaya_get_faq_items($node),
    'catalog_display' => $catalog_display,
    'catalog_title' => bootstrap_posadochnaya_field_plain($node, [
      'field_catalog_title',
      'field_katalog_zagolovok',
      'field_zagolovok_katalog',
    ]),
    'catalog_lead' => bootstrap_posadochnaya_field_markup($node, [
      'field_katalog_tekst',
      'field_katalog_opisanie',
    ]),
    'meta_description' => bootstrap_posadochnaya_field_plain($node, [
      'field_meta_description',
      'field_metatag_description',
    ]),
    'tour_source' => $node->label(),
  ];
}

/**
 * Каталог домов на SEO-лендингах и ponton (nodes 838, 840, 850, 851, 853, 854, 875, 954, 955, 956, 968, 969, 978).
 */
function bootstrap_is_landing_catalog_page(): bool {
  return bootstrap_is_landing_v2_page()
    || bootstrap_is_landing_ponton_page()
    || bootstrap_is_landing_istra_page()
    || bootstrap_is_landing_novaya_riga_page()
    || bootstrap_is_landing_u_vody_page()
    || bootstrap_is_landing_zakrytyy_page()
    || bootstrap_is_landing_biznes_page()
    || bootstrap_is_landing_podmoskove_page()
    || bootstrap_is_landing_kommunikatsii_page()
    || bootstrap_is_landing_gaz_page()
    || bootstrap_is_landing_prozhivanie_page()
    || bootstrap_is_landing_park_page()
    || bootstrap_is_landing_infrastructure_page()
    || bootstrap_is_mfk_page()
    || bootstrap_is_posadochnaya_ponton_page();
}

/**
 * Слайдеры novyy_slayder1 на лендингах 838 / 840.
 */
function bootstrap_is_landing_slider_page(): bool {
  return bootstrap_is_landing_catalog_page() || bootstrap_is_posadochnaya_katalog_page() || bootstrap_is_mfk_page();
}

/**
 * Implements hook_preprocess_HOOK() for views list.
 */
function bootstrap_preprocess_views_view_list(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view && $view->id() === 'gotovye_doma' && $view->current_display === 'block_6' && bootstrap_is_landing_catalog_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__block_6__landing_v2';
  }
  if ($view && $view->id() === 'gotovye_doma' && bootstrap_is_landing_v2_page() && in_array($view->current_display, ['block_3', 'block_4', 'block_5', 'block_6'], TRUE)) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__landing_v2_tab';
  }
  if ($view && $view->id() === 'gotovye_doma' && $view->current_display === 'block_6' && bootstrap_is_seo_kupit_dom_novaya_riga_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__block_6__page_852';
  }
  if ($view && $view->id() === 'gotovye_doma' && $view->current_display === 'block_6' && bootstrap_is_posadochnaya_landing_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__block_6__posadochnaya_sidebar';
  }
  if ($view && $view->id() === 'gotovye_doma' && $view->current_display === 'block_1' && bootstrap_is_seo_gotovye_doma_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__block_1__page_50';
  }
  if ($view && $view->id() === 'gotovye_doma' && $view->current_display === 'block_1' && bootstrap_is_posadochnaya_landing_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__gotovye_doma__block_1__page_50';
  }
  if ($view && $view->id() === 'novyy_slayder1' && bootstrap_is_landing_slider_page()) {
    $variables['theme_hook_suggestions'][] = 'views_view_list__novyy_slayder1';
  }
  if ($view && bootstrap_is_posadochnaya_landing_page()) {
    $node = bootstrap_get_route_node();
    if ($node instanceof NodeInterface) {
      $posadochnaya = bootstrap_posadochnaya_page_data($node);
      $variables['posadochnaya_catalog_title'] = $posadochnaya['catalog_title'];
      $variables['posadochnaya_catalog_lead'] = $posadochnaya['catalog_lead'];
    }
  }
}


/**
 * Страница карты инфраструктуры (/karta).
 */
function bootstrap_is_karta_page(): bool {
  $current = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current);
  return $alias === '/karta' || str_starts_with((string) $alias, '/karta/');
}

/**
 * Поддомен poselok.* (блог).
 */
function bootstrap_is_poselok_host(): bool {
  $host = strtolower(\Drupal::request()->getHost());
  return str_starts_with($host, 'poselok.');
}

/**
 * Страницы блога: материалы, список, категории.
 */
function bootstrap_is_blog_page(?string $node_type = NULL): bool {
  if ($node_type === 'blog') {
    return TRUE;
  }

  $route_name = (string) \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($route_name, 'view.blog.')) {
    return TRUE;
  }

  $alias = '/' . ltrim((string) \Drupal::service('path_alias.manager')->getAliasByPath(
    \Drupal::service('path.current')->getPath()
  ), '/');
  if ($alias === '/blog' || str_starts_with($alias, '/blog/')) {
    return TRUE;
  }

  if ($route_name === 'entity.taxonomy_term.canonical') {
    $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term_alias = '/' . ltrim((string) \Drupal::service('path_alias.manager')->getAliasByPath(
        '/taxonomy/term/' . $term->id()
      ), '/');
      if ($term_alias === '/blog' || str_starts_with($term_alias, '/blog/')) {
        return TRUE;
      }
    }
  }

  return FALSE;
}

/**
 * Блог на поддомене poselok.
 */
function bootstrap_is_poselok_blog_page(?string $node_type = NULL): bool {
  return bootstrap_is_poselok_host() && bootstrap_is_blog_page($node_type);
}

/**
 * Телефон и Calltouch для текущей страницы.
 */
function bootstrap_apply_site_contact_settings(array &$variables, ?string $node_type = NULL): void {
  $variables['site_phone_tel'] = '+74951865088';
  $variables['site_phone_display'] = '+7 (495) 186-50-88';
  $variables['disable_calltouch'] = FALSE;

  if (bootstrap_is_poselok_host()) {
    $variables['site_phone_tel'] = '+74992831148';
    $variables['site_phone_display'] = '+7 (499) 283-11-48';
  }
  if (bootstrap_is_poselok_blog_page($node_type)) {
    $variables['disable_calltouch'] = TRUE;
  }
}

/**
 * Подмена основного телефона в HTML/рендер-массивах для poselok.
 */
function bootstrap_replace_poselok_phone_in_render_array(array &$element): void {
  if (!bootstrap_is_poselok_host()) {
    return;
  }
  $search = [
    'tel:+74951865088',
    '+7 (495) 186-50-88',
    '+74951865088',
  ];
  $replace = [
    'tel:+74992831148',
    '+7 (499) 283-11-48',
    '+74992831148',
  ];
  foreach ($element as $key => &$value) {
    if (is_array($value)) {
      bootstrap_replace_poselok_phone_in_render_array($value);
    }
    elseif (is_string($value)) {
      $value = str_replace($search, $replace, $value);
    }
  }
}


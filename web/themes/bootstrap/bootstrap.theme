<?php

/**
 * @file
 * Functions to support theming in the Bootstrap theme.
 */

use Drupal\Core\Template\Attribute;
use Drupal\Core\Link;
use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Component\Utility\Xss;
use Drupal\node\Entity\Node;
use Drupal\Component\Render\MarkupInterface;
use Drupal\Core\File\FileUrlGeneratorInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;


/**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 *
 * Adds body classes if certain regions have content.
 */
function bootstrap_preprocess_html(&$variables) {
  if (!isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [];
  }

  $current = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current);
  if ($alias === '/ferma' || str_starts_with((string) $alias, '/ferma/')) {
    $variables['attributes']['class'][] = 'path-ferma';
  }
  if (bootstrap_is_karta_page()) {
    $variables['attributes']['class'][] = 'path-karta';
  }

  // Color settings
  if (theme_get_setting('bootstrap_enable_color')) {
    $variables['#attached']['library'][] = 'bootstrap/colors';
    // CSS variables
    $gray200 = '#e9ecef';
    $gray800 = '#343a40';
    $white = '#fff';
    $pc = theme_get_setting('bootstrap_base_primary_color') ?? '#2F3C7E';
    $pcrgb = _hex2rgb( $pc );
    $pcd = _color_luminance($pc, -0.15);
    $bc = '#000';
    $pct = _getContrastColor($pc, $white, $bc);
    $sc = theme_get_setting('bootstrap_base_secondary_color') ?? '#FBEAEB';
    $scrgb = _hex2rgb( $sc );
    $scd = _color_luminance($sc, -0.15);
    $sct = _getContrastColor($sc, $white, $gray800);
    $colors = [
      'white' => $white,
      'black' => '#000',
      'gray-200' => $gray200,
      'gray-800' => $gray800,
      'primary' => $pc,
      'secondary' => $sc,
    ];
    $color = _get_color(theme_get_setting('bootstrap_body_color') ?? 'gray-800', $colors);
    $colors['base'] = $color;
    $bg = _get_color(theme_get_setting('bootstrap_body_bg_color') ?? 'white', $colors);
    $h1 = _get_color(theme_get_setting('bootstrap_h1_color') ?? 'base', $colors);
    $h2 = _get_color(theme_get_setting('bootstrap_h2_color') ?? 'base', $colors);
    $h3 = _get_color(theme_get_setting('bootstrap_h3_color') ?? 'base', $colors);
    $styles = [
      "--bs-primary:$pc;",
      "--bb-primary-dark:$pcd;",
      "--bb-primary-light:$pct;",
      "--bs-primary-rgb:$pcrgb;",
      "--bs-secondary:$sc;",
      "--bb-secondary-dark:$scd;",
      "--bs-secondary-rgb:$scrgb;",
      "--bs-link-color:$pc;",
      "--bs-link-hover-color:$pcd;",
      "--bs-body-color:$color;",
      "--bs-body-bg:$bg;",
      "--bb-h1-color:$h1;",
      "--bb-h2-color:$h2;",
      "--bb-h3-color:$h3;",
    ];
    $variables['html_attributes']->setAttribute('style', implode('', $styles));
  }

  // Add information about the number of sidebars.
  if (!empty($variables['page']['sidebar_first']) && !empty($variables['page']['sidebar_second'])) {
    $variables['attributes']['class'][] = 'layout-two-sidebars';
  }
  elseif (!empty($variables['page']['sidebar_first'])) {
    $variables['attributes']['class'][] = 'layout-one-sidebar';
    $variables['attributes']['class'][] = 'layout-sidebar-first';
  }
  elseif (!empty($variables['page']['sidebar_second'])) {
    $variables['attributes']['class'][] = 'layout-one-sidebar';
    $variables['attributes']['class'][] = 'layout-sidebar-second';
  }
  else {
    $variables['attributes']['class'][] = 'layout-no-sidebars';
  }

  if (!empty($variables['page']['featured_top'])) {
    $variables['attributes']['class'][] = 'has-featured-top';
  }

  bootstrap_apply_site_contact_settings($variables, $variables['node_type'] ?? NULL);
  if (bootstrap_is_poselok_host()) {
    $variables['attributes']['class'][] = 'poselok-host';
  }
  if (!empty($variables['disable_calltouch'])) {
    $variables['attributes']['class'][] = 'poselok-blog';
  }

  // Scroll Spy info added to body.
  if ($scroll_spy = theme_get_setting('bootstrap_scroll_spy')) {
    $variables['attributes']['data-bs-target'] = $scroll_spy;
    $variables['attributes']['data-bs-spy'] = "scroll";
  }

  // Page specific info.
  $variables['path_info']['args'] = FALSE;
  $path = \Drupal::service('path.current')->getPath();
  $path = ltrim($path, '/');
  $path_args = explode('/', $path);
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $front_node = bootstrap_get_front_page_node();
    if ($front_node instanceof NodeInterface) {
      $variables['attributes']['class'][] = 'page-node-' . $front_node->id();
    }
  }

  if (isset($path_args[0]) && isset($path_args[1]) && ($path_args[0] == 'node') && (is_numeric($path_args[1]))) {
    $variables['attributes']['class'][] = 'page-node-' . $path_args[1];
    if ((int) $path_args[1] === 850) {
      $variables['head_title'] = [
        'Коттеджный поселок в Истре — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 851) {
      $variables['head_title'] = [
        'Коттеджный поселок на Новой Риге — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 875) {
      $variables['head_title'] = [
        'Коттеджный поселок у воды — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 954) {
      $variables['head_title'] = [
        'Закрытый коттеджный поселок — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 955) {
      $variables['head_title'] = [
        'Коттеджный поселок бизнес-класса — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 956) {
      $variables['head_title'] = [
        'Коттеджный поселок в Подмосковье — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 968) {
      $variables['head_title'] = [
        'Коттеджный поселок с коммуникациями — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 969) {
      $variables['head_title'] = [
        'Коттеджный поселок с газом — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 978) {
      $variables['head_title'] = [
        'Коттеджный поселок для постоянного проживания — КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 980) {
      $variables['head_title'] = [
        'Забота о доме начинается здесь — сервис УК в КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 852) {
      $variables['head_title'] = [
        'Купить дом на Новой Риге в КП «Берег Песочной»',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 50) {
      $variables['head_title'] = [
        'Купить готовый дом с участком в КП «Берег Песочной» на Новой Риге',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 853) {
      $variables['head_title'] = [
        'Парк с прудом в КП «Берег Песочной» — ландшафтный парк 8 га',
        'Берег Песочной',
      ];
    }
    if ((int) $path_args[1] === 854) {
      $variables['head_title'] = [
        'Инфраструктура КП «Берег Песочной» — коммуникации и сервисы для жизни',
        'Берег Песочной',
      ];
    }
  }

  if (isset($path_args[0]) && isset($path_args[1]) && ($path_args[0] == 'user')) {
    $variables['attributes']['class'][] = 'page-user-' . $path_args[1];
  }
  if (isset($path_args[0]) && isset($path_args[1]) && isset($path_args[2]) &&
    $path_args[0] == 'taxonomy' && $path_args[1] == 'term') {
    $variables['attributes']['class'][] = 'page-taxonomy-term-' . $path_args[2];
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($path_args[2]);
    if (!empty($term)) {
      $vocabulary_id = $term->bundle();
      $variables['attributes']['class'][] = 'page-vocabulary-' . Html::cleanCssIdentifier($vocabulary_id);
    }
  }
  $view_id = \Drupal::routeMatch()->getParameter('view_id');
  if ($view_id) {
    $variables['attributes']['class'][] = 'page-view-' . Html::cleanCssIdentifier($view_id);
  }

  // SEO Information.
  $http_equiv = [
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => [
      'http-equiv' => 'x-ua-compatible',
      'content' => 'ie=edge',
    ],
  ];
  $variables['page']['#attached']['html_head'][] = [$http_equiv, 'http-equiv'];

}

/**
 * Implements hook_page_attachments_alter() for page templates.
 */
function bootstrap_page_attachments_alter(&$page) {
  $viewport = [
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'viewport',
      'content' => 'width=device-width, initial-scale=1, shrink-to-fit=no',
    ],
  ];
  $route_name = \Drupal::routeMatch()->getRouteName();
  $node = \Drupal::routeMatch()->getParameter('node');

  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && $node->id() == 559) {
    $page['#attached']['library'][] = 'bootstrap/atelier_script';
  }
  if (bootstrap_is_node_page(838)) {
    $page['#attached']['library'][] = 'bootstrap/landing_dev2';
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 840) {
    $page['#attached']['library'][] = 'bootstrap/landing_ponton';
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 850) {
    $page['#attached']['library'][] = 'bootstrap/landing_istra';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Коттеджный поселок «Берег Песочной» рядом с Истрой, 45 км от МКАД. Дома и участки в Истринском районе, парк 8 га, река Песочная, охрана, городские коммуникации и инфраструктура Истры в 10 минутах.',
        ],
      ],
      'istra_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 851) {
    $page['#attached']['library'][] = 'bootstrap/landing_novaya_riga';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Коттеджный поселок «Берег Песочной» на Новой Риге — 45 км от МКАД, 10 минут до Истры. Закрытый КП бизнес-класса с парком 8 га, рекой Песочная, домами и участками для постоянного проживания.',
        ],
      ],
      'nrg_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 875) {
    $page['#attached']['library'][] = 'bootstrap/landing_u_vody';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Коттеджный поселок «Берег Песочной» у воды — река Песочная, Истринское водохранилище рядом, парк 8 га. Дома и участки в Истринском районе на Новой Риге для жизни круглый год.',
        ],
      ],
      'u_vody_landing_description',
    ];
  }
  if ($route_name === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && (int) $node->id() === 954) {
    $page['#attached']['library'][] = 'bootstrap/landing_zakrytyy';
    $page['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'description',
          'content' => 'Закрытый коттеджный поселок «Берег Песочной» на Новой Риге — охрана 24/7, видеонаблюдение, контроль доступа, парк 8 га. Дома в охраняемом КП в Истринском районе для жизни круглый год.',
        ],

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.querySelector('.cart-first-slider-cont');
        const items = Array.from(slider.children);
        const prevButton = document.querySelector('.cart-back');
        const nextButton = document.querySelector('.cart-next');
        let gap = 35; // Изначальный гап между слайдами
        let currentIndex = 0;

        // Функция для обновления гапа в зависимости от ширины экрана
        const updateGap = () => {
            gap = window.innerWidth < 600 ? 15 : 35;
        };

        // Функция для обновления слайдера
        const updateSlider = () => {
            if (window.innerWidth < 1200) {
                const visibleSlideWidth = items.find(item => item.classList.contains('visible')).offsetWidth;
                const offset = -(currentIndex * (visibleSlideWidth + gap));
                slider.style.transform = `translateX(${offset}px)`;

                items.forEach((item, index) => {
                    item.classList.toggle('active', index === currentIndex);
                    item.classList.toggle('visible', index !== currentIndex);
                });
            }
        };

        // Функция для инициализации слайдера
        const initializeSliderX = () => {
            if (window.innerWidth < 1200) {
                currentIndex = items.findIndex(item => item.classList.contains('active'));
                if (window.innerWidth < 1200) {
                    currentIndex = 0;
                }
                updateGap(); // Обновляем гап перед обновлением слайдера
                updateSlider(); // Инициализируем слайдер
            }
        };

        // Обработчики событий для кнопок
        const setupButtons = () => {
            if (window.innerWidth < 1200) {
                prevButton.addEventListener('click', () => {
                    currentIndex = (currentIndex > 0) ? currentIndex - 1 : items.length - 1;
                    updateSlider();
                });

                nextButton.addEventListener('click', () => {
                    currentIndex = (currentIndex < items.length - 1) ? currentIndex + 1 : 0;
                    updateSlider();
                });
            }
        };

        // Инициализация слайдера после загрузки страницы
        window.addEventListener('load', () => {
            initializeSliderX();
            setupButtons();
        });

        // Обработка изменения размера окна
        window.addEventListener('resize', () => {
            if (window.innerWidth < 1200) {
                updateGap(); // Обновляем гап при изменении размера окна
                initializeSliderX();
                setupButtons();
            } else {
                // Если ширина больше или равна 1200, убираем обработчики
                prevButton.removeEventListener('click', setupButtons);
                nextButton.removeEventListener('click', setupButtons);
                slider.style.transform = ''; // Сброс смещения, если было
            }
        });
    });

</script>
</script>

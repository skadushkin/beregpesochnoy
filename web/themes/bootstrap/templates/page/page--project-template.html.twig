{% if node.field_house_project.entity is not empty %}
    {% set related_node = node.field_house_project.entity %}
{% endif %}

<section>
    <div class="cart-first-container container">
        <div class="cart-first in-container">
            <div class="first-crumbs">
                {{ page.breadcrumb }}
            </div>
            <div class="cart-first-title t-50-400-60 t3-mob">
                <h1>
                    {% if node.field_h1_field.value is not empty %}
                    {{ node.field_h1_field.value }}
                    {% else %}
                        {% if related_node.title.value is not empty %}
                            {{ related_node.title.value }}, {{ node.title.value }}
                        {% endif %}
                    {% endif %}
                </h1> {# Использование поля H1 заголовка #}
            </div>

            {{ page.content }}

        </div>
    </div>
</section>
























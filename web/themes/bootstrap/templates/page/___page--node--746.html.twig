<script>
    document.querySelectorAll('.category-item').forEach(item => {
    const label = item.querySelector('.category-label');
    const fillColor = item.dataset.fill;
    let active = true;

    label.addEventListener('click', () => {
        const paths = document.querySelectorAll(`#overlay-image path[fill="${fillColor}"]`);

        paths.forEach(path => {
        if (active) {
            path.setAttribute('fill-opacity', '0');
        } else {
            path.setAttribute('fill-opacity', '0.4');
        }
        });

        active = !active;
        item.classList.toggle('inactive');
    });
    });
    document.addEventListener("DOMContentLoaded", function () {
        const panzoomElem = document.getElementById("panzoom");
        const overlayImage = document.getElementById("overlay-image");
        const imageContainer = document.getElementById("image-container");
        const mainImage = document.getElementById("main-image");
        // Инициализируем Panzoom
        const panzoomInstance = Panzoom(panzoomElem, {
            maxScale: 3,
            minScale: 1,
            contain: "outside",
            startScale: 1,
            //panOnlyWhenZoomed: false,
        });
        //panzoomInstance.setTransform(0, 0, 1.1);
        function centerImage() {
            const containerWidth = imageContainer.clientWidth;
            const containerHeight = imageContainer.clientHeight;
            const imageWidth = mainImage.width;
            const imageHeight = mainImage.height;
            const scale = 1;
            // Вычисляем сдвиг для центрирования
            const offsetX = (containerWidth - imageWidth * 1.1) / 2;
            const offsetY = (containerHeight - imageHeight * 1.1) / 2;

            panzoomInstance.zoom(scale, { animate: false });
            panzoomInstance.pan(offsetX, offsetY, { animate: false });
        }

        centerImage(); // Центрируем при загрузке

        // Центрируем при изменении размера окна
        window.addEventListener("resize", centerImage);
        // Масштабирование колесиком мыши
        panzoomElem.parentElement.addEventListener("wheel", function (event) {
            panzoomInstance.zoomWithWheel(event);
        });

        // Кнопки увеличения и уменьшения масштаба
        document.getElementById("zoom-in").addEventListener("click", function () {
            panzoomInstance.zoomIn();
        });

        document.getElementById("zoom-out").addEventListener("click", function () {
            panzoomInstance.zoomOut();
        });

        // Поддержка тач-жестов
        panzoomElem.addEventListener("touchstart", function (event) {
            if (event.touches.length === 2) {
                event.preventDefault();
            }
        }, { passive: false });

        document.getElementById("fullscreen-btn").addEventListener("click", function () {
            const imageContainer = document.getElementById("image-container");
            const tooltip = document.getElementById("tooltip");
            const body = document.body;

            if (!document.fullscreenElement) {
                if (imageContainer.requestFullscreen) {
                    imageContainer.requestFullscreen();
                } else if (imageContainer.mozRequestFullScreen) {
                    imageContainer.mozRequestFullScreen();
                } else if (imageContainer.webkitRequestFullscreen) {
                    imageContainer.webkitRequestFullscreen();
                } else if (imageContainer.msRequestFullscreen) {
                    imageContainer.msRequestFullscreen();
                }
                imageContainer.classList.add("fullscreen");
                imageContainer.appendChild(tooltip); // Перемещаем tooltip внутрь imageContainer
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.mozCancelFullScreen) {
                    document.mozCancelFullScreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
            }
        });

        // Обработчик для корректного возврата tooltip после выхода из полноэкранного режима
        document.addEventListener("fullscreenchange", function () {
            const imageContainer = document.getElementById("image-container");
            const tooltip = document.getElementById("tooltip");
            const body = document.body;

            if (!document.fullscreenElement) {
                imageContainer.classList.remove("fullscreen");
                body.appendChild(tooltip); // Возвращаем tooltip обратно в body
            }
        });


    });

    function updateOverlaySize() {
        const baseImage = document.getElementById('main-image'); // Основное изображение
        const overlay = document.getElementById('overlay-image'); // Первая наложенная картинка
        const infra = document.getElementById('infra-image'); // Вторая наложенная картинка (инфраструктура)

        if (!baseImage) return;

        // Исходные размеры
        const originalBaseWidth = 1198;
        const originalBaseHeight = 673;

        // Текущие размеры основного изображения
        const newBaseWidth = baseImage.clientWidth;
        const newBaseHeight = baseImage.clientHeight;

        // Коэффициенты масштабирования
        const scaleX = newBaseWidth / originalBaseWidth;
        const scaleY = newBaseHeight / originalBaseHeight;

        // === Обновляем первую наложенную картинку ===
        if (overlay) {
            const originalOverlayWidth = 916;
            const originalOverlayHeight = 523;
            const originalOverlayTop = 149;
            const originalOverlayLeft = 108;

            overlay.style.width = `${originalOverlayWidth * scaleX}px`;
            overlay.style.height = `${originalOverlayHeight * scaleY}px`;
            overlay.style.top = `${originalOverlayTop * scaleY}px`;
            overlay.style.left = `${originalOverlayLeft * scaleX}px`;
        }

        // === Обновляем вторую наложенную картинку (инфраструктура) ===
        if (infra) {
            const originalInfraWidth = 1180;
            const originalInfraTop = 0; // если надо сместить — можно изменить
            const originalInfraLeft = 10;

            infra.style.width = `${originalInfraWidth * scaleX}px`;
            infra.style.top = `${originalInfraTop * scaleY}px`;
            infra.style.left = `${originalInfraLeft * scaleX}px`;
        }
        }

        // Запускаем при изменении размера экрана и при загрузке страницы
    window.addEventListener('resize', updateOverlaySize);
    document.addEventListener('DOMContentLoaded', updateOverlaySize);
    document.getElementById("infra-toggle").addEventListener("change", function () {
        const img = document.getElementById("infra-image");
        img.style.display = this.checked ? "none" : "block";
    });

</script>

</section>



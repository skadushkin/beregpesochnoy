{% block content %}

    <section class="bg1 {{ container }}">
        <div class="first-container"{{ content_attributes }}>
            <div class="invest-first">
                <div class="first-crumbs">
                    {{ page.breadcrumb }}
                </div>
                <div class="first-title">
                    <h1>{{ title|raw }}</h1>
                    <img src="/sites/default/files/img/foto-n4.jpg" style="margin-top:25px">
                </div>


            </div>
        </div>
    </section>
    <section class="bg2">
        <div class="container">
            <div class="container_w2">
                <div class="article-page">
                    {{ page.content }}
                </div>

            </div>

        </div>
    </section>

    {{ drupal_entity('block_content', '21') }}
    {{ drupal_entity('block_content', '45') }}
    {{ drupal_entity('block_content', '14') }}

    {% if sidebar_first_exists %}
        <div{{ sidebar_first_attributes }}>
            <aside class="section" role="complementary">
                {{ page.sidebar_first }}
            </aside>
        </div>
    {% endif %}
    {% if sidebar_second_exists %}
        <div{{ sidebar_second_attributes }}>
            <aside class="section" role="complementary">
                {{ page.sidebar_second }}
            </aside>
        </div>
    {% endif %}
{% endblock %}

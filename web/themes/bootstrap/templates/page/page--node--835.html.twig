<style>
	article {
		display: none;
	}
	.before-blue::after {
		display: none;
	}
	.catalog-container p {
		padding-bottom: 20px;
	}
	.main-wrapper {
		width: 100%;
		max-width: 1340px;
		margin: 0 auto;
	}

	.wheel-card {
		background: var(--surface);
		border-radius: 48px;
		box-shadow: var(--shadow);
		overflow: hidden;
		border: 1px solid var(--border-light);
		backdrop-filter: blur(2px);
	}

	.layout {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		min-height: 720px;
	}

	.wheel-column {
		flex: 1 1 50%;
		min-width: 300px;
		/* background: linear-gradient(145deg, #fffbf2 0%, #fef7e9 100%); */
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px 20px;
		position: relative;
	}

	.wheel-stage {
		position: relative;
		width: 100%;
		max-width: 700px;
		aspect-ratio: 1 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto;
	}
    

    .wheel-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
    }
	.pointer {
        position: absolute;
        right: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 0;
        height: 0;
        border-top: 30px solid transparent;
        border-bottom: 30px solid transparent;
        border-right: 68px solid #171717;
        z-index: 20;
        pointer-events: none;
        filter: drop-shadow(0 5px 7px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 1px rgba(255, 255, 255, 0.35));
    }
    .pointer::after {
        content: '';
        position: absolute;
        top: -18px;
        right: -63px;
        width: 0;
        height: 0;
        border-top: 18px solid transparent;
        border-bottom: 18px solid transparent;
        border-right: 42px solid #2d2d2d;
    }
    .pointer-line {
      position: absolute;
      right: 0;
      top: 50%;
      width: 14px;
      height: 2px;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.85);
      z-index: 21;
      pointer-events: none;
      border-radius: 999px;
      box-shadow: 0 0 6px rgba(255, 255, 255, 0.5);
    }

	.wheel {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 50%;
      object-fit: contain;
      transform-origin: 50% 50%;
      user-select: none;
      -webkit-user-drag: none;
      filter: drop-shadow(0 18px 35px rgba(0, 0, 0, 0.28));
      transition: transform 6s cubic-bezier(0.17, 0.84, 0.21, 1);
      animation: slowSpin 60s linear infinite;
    }

	/* Останавливаем анимацию при наведении для удобства */
	.wheel:hover {
		animation-play-state: paused;
	}

    .wheel-gloss {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      pointer-events: none;
      background:
        radial-gradient(circle at 36% 26%, rgba(255,255,255,0.16), transparent 26%),
        radial-gradient(circle at 50% 50%, transparent 54%, rgba(255,255,255,0.08) 68%, transparent 75%);
      z-index: 2;
    }

	/* Класс для быстрого вращения (переопределяет анимацию) */
	.wheel.spinning-fast {
		animation: none;
		transition: transform 6s cubic-bezier(0.25, 0.1, 0.15, 1);
	}

	@keyframes slowSpin {
		from {
			transform: rotate(0deg);
		}

		to {
			transform: rotate(360deg);
		}
	}

	.wheel::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.15), transparent 38%);
		pointer-events: none;
	}

	.wheel-center {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 22%;
		height: 22%;
		max-width: 110px;
		max-height: 110px;
		border-radius: 50%;
		background: #917357;
		z-index: 5;
		/* box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), inset 0 2px 6px rgba(255, 215, 0, 0.3); */
		/* border: 3px solid #ffd700; */
	}

	.label-layer {
		position: absolute;
		inset: 0;
		z-index: 4;
	}

	.wheel-label {
		position: absolute;
		left: 50%;
		top: 50%;
		transform-origin: 0 0;
		color: #765e50;
		font-weight: 700;
		/* text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5); */
		text-align: left;
		pointer-events: none;
		font-size: calc(12px + 0.35vw);
		line-height: 1.3;
		font-weight: 600;
		/* font-size: 18px; */
		line-height: 138%;
		text-align: center;
		color: #765e50;
		font-family: Merriweather, serif;
	}

	.form-column {
		flex: 1 1 50%;
		min-width: 320px;
		padding: 44px 40px;
		background: var(--surface);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		background: #fef0d9;
		padding: 10px 18px;
		border-radius: 60px;
		font-weight: 600;
		font-size: 0.9rem;
		color: #9e6300;
		margin-bottom: 20px;
		border: 1px solid #fad39c;
		width: fit-content;
	}

	h2 {
		margin: 0 0 12px;
		font-size: clamp(42px, 8vw, 68px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #1f1a0e;
	}

	.rules-box {
		background-color: #f4eada;
		padding: 40px;
		margin-bottom: 24px;

	}
	.h2_sms {
		font-family: Merriweather, serif;
		font-weight: 400;
		font-size: 40px;
		line-height: 138%;
		text-align: center;
		color: #fffbf3;
	}

	.rules-title {
		font-family: 'Cera Pro';
		font-weight: 400;
		font-size: 20px;
		line-height: 160%;
		text-align: center;
		color: #3c3c3b;
		margin-bottom: 20px;
	}

	.rules-list {
		/* list-style: none; */
		padding: 20px;
		margin: 0;
	}

	.rules-list li {
		/* display: flex; */
		align-items: flex-start;
		gap: 10px;
		margin-bottom: 15px;
		font-family: 'Cera Pro';
		font-weight: 400;
		font-size: 16px;
		line-height: 150%;
		color: #3c3c3b;
	}

	.rules-list li:last-child {
		margin-bottom: 0;
	}

	.rules-list .emoji {
		font-size: 1.1rem;
		min-width: 22px;
	}

	.lead {
		/* font-size: 1.2rem; */
		line-height: 1.5;
		color: var(--text-secondary);
		margin-bottom: 24px;
	}

	.form-box {
		max-width: 540px;
	}

	.field {
		margin-bottom: 18px;
	}

	.field input {
		width: 100%;
		padding: 20px 22px;
		font-size: 16px;
		border: none;
		text-align: center;
		/* border-radius: 24px; */
		border-bottom: 0.75px solid #765e50;
		background: transparent;
		outline: none;
		transition: all 0.2s;
		color: #765e50;
		/* box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02); */
	}

	.field input:focus {
		border-color: var(--gold-main);
		/* box-shadow: 0 0 0 4px rgba(230, 168, 23, 0.12); */
	}

	.field input::placeholder {
		color: #b6a58b;
	}

	.field input.error {
		border-color: var(--danger);
	}

	.phone-wrap {
		position: relative;
	}

	.phone-prefix {
		position: absolute;
		left: 22px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.2rem;
		font-weight: 600;
		color: #7a5c2e;
	}

	.phone-wrap input {
		;
		/* padding-left: 68px; */
	}

	.action-btn {
		border-radius: 50px;
		padding: 22px 30px;


		background: linear-gradient(165deg, var(--gold-dark) 0%, var(--gold-main) 100%);
		background: #765e50;
		border: none;
		color: #1e1606;
		font-weight: 500;
		font-size: 16px;
		text-transform: uppercase;
		text-align: center;
		color: #fffbf3;
		width: 100%;
		cursor: pointer;
		/* box-shadow: 0 12px 28px -6px rgba(198, 139, 28, 0.4); */
		transition: all 0.2s;
		/* border: 1px solid #ffdf9c; */
		margin-top: 17px;
	}

	.action-btn:hover:not(:disabled) {
		transform: scale(1.01);
		/* background: linear-gradient(165deg, #d99b1f, #f5b82e); */
		/* box-shadow: 0 16px 32px -8px rgba(212, 95, 0, 0.3); */
	}

	.action-btn:disabled {
		opacity: 0.7;
		transform: none;
		box-shadow: none;
		cursor: not-allowed;
	}

	.status {
		margin-top: 16px;
		/* min-height: 32px; */
		font-weight: 500;
		color: #7b5e3b;
	}

	.status.success {
		color: #1f7a4a;
	}

	.status.error {
		color: #b13e3e;
	}

	.agreement {
		margin-top: 24px;
		font-size: 0.8rem;
		color: #a08c72;
		line-height: 1.5;
	}

	.agreement a {
		color: #b5721a;
		text-decoration: none;
		border-bottom: 1px solid #ebc47f;
	}

	.won-box {
		margin-top: 24px;
		background: #fef6e8;
		border-radius: 30px;
		padding: 28px 26px;
		border: 1px solid #f3d9b1;
	}

	.won-box .label {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		color: #b77e1e;
		font-weight: 600;
	}

	.won-box .gift {
		font-size: 2.4rem;
		font-weight: 900;
		line-height: 1.2;
		margin: 8px 0 10px;
		color: #392e1a;
	}

	.won-box .desc {
		color: #65573e;
	}

	/* Кнопка управления звуком */
	.sound-toggle {
		position: fixed;
		bottom: 20px;
		right: 20px;
		width: 50px;
		height: 50px;
		border-radius: 50%;
		background: var(--surface);
		border: 2px solid var(--gold-main);
		box-shadow: var(--shadow);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 100;
		font-size: 24px;
		transition: all 0.2s;
	}

	.sound-toggle:hover {
		transform: scale(1.1);
	}

	.sound-toggle.muted {
		opacity: 0.6;
	}

	@media(max-width: 820px) {
		body {
			;
			/* padding: 8px; */
		}

		.wheel-card {
			border-radius: 36px;
		}

		.layout {
			flex-direction: column;
		}

		.form-column {
			order: 1;
			padding: 32px 24px 16px;
		}

		.wheel-column {
			/* order: 2; */
			padding: 0 20px 40px;
			min-height: auto;
		}

		.wheel-stage {
			max-width: 420px;
			margin: 0 auto;
		}

		.pointer {
			right: -2px;
			top: 50%;
			transform: translateY(-50%);
			border-top: 20px solid transparent;
			border-bottom: 20px solid transparent;
			border-right: 44px solid #ffd700;
			border-left: 0;
			border-bottom-color: transparent;
		}

		.wheel-column {
			padding-bottom: 48px;
			padding-top: 8px;
		}

		.wheel-label {
			font-size: 9px;
		}

		.form-column {
			padding-bottom: 8px;
		}

		h2 {
			font-size: 46px;
			margin-bottom: 8px;
		}

		.lead {
			font-size: 1rem;
			margin-bottom: 20px;
		}

		.rules-box {
			padding: 14px 18px;

		}


		.sound-toggle {
			bottom: 15px;
			right: 15px;
			width: 45px;
			height: 45px;
			font-size: 20px;
		}
	}

	@media(max-width: 480px) {
		.wheel-stage {
			max-width: 340px;
		}

		.pointer {
			right: -1px;
			border-top-width: 16px;
			border-bottom-width: 16px;
			border-right-width: 36px;
		}

		.wheel-label {
			font-size: 8px;
		}

		.form-column {
			padding: 24px 18px 8px;
		}

		.action-btn {
			font-size: 1.2rem;
			padding: 18px 20px;
		}

		.field input {
			padding: 16px 18px;
			font-size: 1rem;
		}

		.phone-prefix {
			left: 18px;
			font-size: 1rem;
		}

		.phone-wrap input {
			padding-left: 58px;
		}

		.won-box .gift {
			font-size: 2rem;
		}

		.rules-list li {
			font-size: 0.85rem;
		}
	}

	@media(max-width: 360px) {
		.wheel-stage {
			max-width: 290px;
		}

		.pointer {
			border-right-width: 30px;
		}
	}
</style>


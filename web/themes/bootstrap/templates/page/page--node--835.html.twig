        },
        {
          id: 'gas-compensation',
          title: 'Компенсация за газоснабжение',
          emailText: 'Выиграл подарок: Компенсация за газоснабжение',
          centerAngle: 315
        },
        {
          id: 'automatic-gates',
          title: 'Автоматические ворота',
          emailText: 'Выиграл подарок: Автоматические ворота',
          centerAngle: 0
        },
        {
          id: 'modular-sauna',
          title: 'Модульная баня',
          emailText: 'Выиграл подарок: Модульная баня',
          centerAngle: 45
        },
        {
          id: 'year-no-utilities',
          title: 'Год без коммуналки',
          emailText: 'Выиграл подарок: Год без коммуналки',
          centerAngle: 90
        },
        {
          id: 'fridge-gift',
          title: 'Холодильник в подарок',
          emailText: 'Выиграл подарок: Холодильник в подарок',
          centerAngle: 135
        },
        {
          id: 'drainage',
          title: 'Дренаж участка',
          emailText: 'Выиграл подарок: Дренаж участка',
          centerAngle: 180
        },
        {
          id: 'green-hedge',
          title: 'Зеленая изгородь',
          emailText: 'Выиграл подарок: Зеленая изгородь',
          centerAngle: 225
        }
      ];

      const STORAGE_KEY = 'jbi_wheel_result_onsite_v2_png';

      const wheel = document.getElementById('wheel');
      const spinBtn = document.getElementById('spinBtn');
      const statusEl = document.getElementById('status');
      const nameInput = document.getElementById('nameInput');
      const phoneInput = document.getElementById('phoneInput');
      const formBox = document.getElementById('formBox');
      const wonBox = document.getElementById('wonBox');
      const giftText = document.getElementById('giftText');
      const leadText = document.getElementById('leadText');
      const wheelForm = document.getElementById('wheelForm');
      const soundToggle = document.getElementById('soundToggle');
      const wheelSound = document.getElementById('wheelSound');

      let currentRotation = 0;
      let spinning = false;
      let soundEnabled = true;

      wheelSound.volume = 0.4;

      function normalizeAngle(angle) {
        return ((angle % 360) + 360) % 360;
      }

      function getCurrentCssRotation(element) {
        const transform = window.getComputedStyle(element).transform;

        if (!transform || transform === 'none') {
          return 0;
        }

        const values = transform.split('(')[1].split(')')[0].split(',');

        if (values.length < 2) {
          return 0;
        }

        const a = parseFloat(values[0]);
        const b = parseFloat(values[1]);

        return Math.atan2(b, a) * (180 / Math.PI);
      }

      function showConfetti() {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { x: 0.5, y: 0.5 },
          colors: ['#c87a24', '#e6a817', '#ffd700', '#ffffff', '#1a1a1a']
        });

        setTimeout(() => {
          confetti({
            particleCount: 50,
            angle: 60,
            spread: 55,
            origin: { x: 0, y: 0.8 },
            colors: ['#c87a24', '#e6a817', '#ffd700']
          });

          confetti({
            particleCount: 50,
            angle: 120,
            spread: 55,
            origin: { x: 1, y: 0.8 },
            colors: ['#c87a24', '#e6a817', '#ffd700']
          });
        }, 200);
      }

      function normalizePhoneDigits(value) {
        let digits = String(value || '').replace(/\D/g, '');
        if (digits.length >= 11 && (digits[0] === '7' || digits[0] === '8')) {
          digits = digits.slice(1);
        }
        return digits.slice(0, 10);
      }

      function formatPhone(value) {
        const digits = normalizePhoneDigits(value);
        const parts = [];

        if (digits.substring(0, 3)) parts.push(digits.substring(0, 3));
        if (digits.substring(3, 6)) parts.push(digits.substring(3, 6));
        if (digits.substring(6, 8)) parts.push(digits.substring(6, 8));
        if (digits.substring(8, 10)) parts.push(digits.substring(8, 10));

        if (parts.length === 0) return '';
        if (parts.length === 1) return parts[0];
        if (parts.length === 2) return `${parts[0]} ${parts[1]}`;
        if (parts.length === 3) return `${parts[0]} ${parts[1]}-${parts[2]}`;

        return `${parts[0]} ${parts[1]}-${parts[2]}-${parts[3]}`;
      }

      function getStored() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        } catch {
          return null;
        }
      }

      function setStored(data) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      }

      function showStatus(msg, type = 'info') {
        statusEl.className = `status ${type}`;
        statusEl.textContent = msg;
      }

      function validate() {
        const name = nameInput.value.trim();
        const phoneDigits = normalizePhoneDigits(phoneInput.value);

        nameInput.classList.remove('error');
        phoneInput.classList.remove('error');

        if (name.length < 2) {
          showStatus('Введите имя минимум из 2 символов.', 'error');
          nameInput.classList.add('error');
          return false;
        }

        if (phoneDigits.length !== 10) {
          showStatus('Введите телефон: 10 цифр после +7.', 'error');
          phoneInput.classList.add('error');
          return false;
        }

        return true;
      }

      function stopSlowAnimation() {
        const liveAngle = getCurrentCssRotation(wheel);

        wheel.classList.add('spinning-fast');
        wheel.style.animation = 'none';

        currentRotation = liveAngle;
        wheel.style.transition = 'none';
        wheel.style.transform = `rotate(${currentRotation}deg)`;

        wheel.offsetHeight;

        wheel.style.transition = 'transform 6s cubic-bezier(0.17, 0.84, 0.21, 1)';
      }

      function startSlowAnimation() {
        wheel.classList.remove('spinning-fast');
        wheel.style.transition = '';
        wheel.style.transform = '';
        wheel.style.animation = 'slowSpin 60s linear infinite';
        currentRotation = 0;
      }

      /*
        Расчёт остановки.

        Стрелка справа — это 0 градусов.
        У каждого приза задан centerAngle — где центр сектора находится на исходной картинке.

        Чтобы выбранный сектор пришёл под стрелку справа:
        итоговый угол вращения должен быть -centerAngle плюс несколько полных оборотов.

        Добавлен небольшой randomOffset внутри сектора, чтобы колесо не останавливалось
        каждый раз идеально в одну и ту же точку.
      */
      function calcRotationForPrize(prizeIndex) {
        const prize = prizes[prizeIndex];

        const fullSpins = 7 + Math.floor(Math.random() * 3);
        const safeOffset = Math.random() * 18 - 9;

        const currentNormalized = normalizeAngle(currentRotation);
        const targetNormalized = normalizeAngle(-prize.centerAngle + safeOffset);

        let delta = targetNormalized - currentNormalized;

        if (delta < 0) {
          delta += 360;
        }

        return currentRotation + fullSpins * 360 + delta;
      }

      function setWheelTransform(rotation) {
        wheel.style.transform = `rotate(${rotation}deg)`;
      }

      function setWheelToPrizeIndex(index) {
        stopSlowAnimation();

        const prize = prizes[index];
        const rotation = -prize.centerAngle;

        currentRotation = rotation;

        wheel.style.transition = 'none';
        setWheelTransform(rotation);

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            wheel.style.transition = 'transform 6s cubic-bezier(0.17, 0.84, 0.21, 1)';
          });
        });
      }

      function applyWonState(result) {
        formBox.style.display = 'none';
        wonBox.style.display = 'block';
        leadText.textContent = '🎉 Ваш подарок уже определён. Менеджер свяжется с вами!';
        giftText.textContent = result.prizeTitle;

        if (typeof result.prizeIndex === 'number') {
          setWheelToPrizeIndex(result.prizeIndex);
        }

        showConfetti();
      }

      function applyReadyState() {
        formBox.style.display = 'block';
        wonBox.style.display = 'none';
        leadText.textContent = 'Введите имя и номер телефона, чтобы получить подарок. После вращения заявка отправится, а бонус закрепится за вами.';
        showStatus('', 'info');
        startSlowAnimation();
      }

      function randomPrizeIndex() {
        return Math.floor(Math.random() * prizes.length);
      }

      function playWheelSound() {
        if (!soundEnabled || !wheelSound) return;

        wheelSound.currentTime = 0;
        wheelSound.play().catch(error => {
          console.log('Ошибка воспроизведения звука:', error);
        });
      }

      function stopWheelSound() {
        if (!wheelSound) return;

        wheelSound.pause();
        wheelSound.currentTime = 0;
      }

      function sendBitrixFallback(payload) {
        if (typeof window.sendLeadToBitrix !== 'function') {
          return;
        }
        const prizeLine = payload.prizeTitle
          ? ('Приз: ' + payload.prizeTitle)
          : '';
        window.sendLeadToBitrix(
          payload.name,
          ' ',
          payload.phone,
          [prizeLine, payload.prizeTextForEmail || ''].filter(Boolean).join('\n'),
          'Колесо фортуны Берег Песочной'
        );
      }

      async function sendLead(payload) {
        try {
          const formData = new FormData();

          formData.append('name', payload.name);
          formData.append('phone', payload.phone);
          formData.append('prize', payload.prizeTitle);
          if (typeof payload.prizeIndex === 'number') {
            formData.append('prize_index', String(payload.prizeIndex));
          }
          if (payload.prizeId) {
            formData.append('prize_id', payload.prizeId);
          }
          formData.append('prize_description', payload.prizeTextForEmail);
          formData.append('source', payload.source);
          formData.append('site', 'bereg');
          formData.append('user_agent', navigator.userAgent);

          const response = await fetch('/send.php', {
            method: 'POST',
            body: formData
          });

          const raw = await response.text();
          let result = {};
          try {
            result = raw ? JSON.parse(raw) : {};
          } catch (parseError) {
            sendBitrixFallback(payload);
            return {
              success: false,
              message: 'Ошибка соединения с сервером. Попробуйте позже.'
            };
          }

          if (!result.success) {
            sendBitrixFallback(payload);
          }
          return result;
        } catch (error) {
          console.error('Ошибка отправки:', error);
          sendBitrixFallback(payload);

          return {
            success: false,
            message: 'Ошибка соединения с сервером. Попробуйте позже.'
          };
        }
      }

      async function handleSpin(e) {
        if (e) e.preventDefault();
        if (spinning) return;
        if (!validate()) return;

        const stored = getStored();

        if (stored) {
          applyWonState(stored);
          return;
        }

        spinning = true;
        spinBtn.disabled = true;

        stopSlowAnimation();
        playWheelSound();

        showStatus('Колесо крутится... Определяем подарок...', 'info');

        const name = nameInput.value.trim();
        const phoneDigits = normalizePhoneDigits(phoneInput.value);
        const phone = `+7${phoneDigits}`;

        const prizeIndex = randomPrizeIndex();
        const prize = prizes[prizeIndex];

        const targetRotation = calcRotationForPrize(prizeIndex);

        currentRotation = targetRotation;

        wheel.style.transition = 'transform 6s cubic-bezier(0.17, 0.84, 0.21, 1)';
        setWheelTransform(currentRotation);

        const payload = {
          name,
          phone,
          prizeIndex,
          prizeId: prize.id,
          prizeTitle: prize.title,
          prizeTextForEmail: prize.emailText,
          source: 'page-node-835-wheel-bereg',
          createdAt: new Date().toISOString()
        };

        const serverResponse = await sendLead(payload);

        const resultData = {
          name,
          phone,
          prizeIndex,
          prizeId: prize.id,
          prizeTitle: prize.title,
          createdAt: new Date().toISOString(),
          emailSent: serverResponse.success || false
        };

        setStored(resultData);

        await new Promise(resolve => setTimeout(resolve, 6100));

        stopWheelSound();

        applyWonState(resultData);

        if (serverResponse.success) {
          showStatus(`✅ Подарок: ${prize.title}. Заявка отправлена! Менеджер скоро свяжется с вами.`, 'success');
        } else {
          showStatus(`🎁 ${prize.title}. ${serverResponse.message || 'Менеджер свяжется с вами в ближайшее время.'}`, 'error');
        }

        spinning = false;
        spinBtn.disabled = false;
      }

      soundToggle.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        soundToggle.textContent = soundEnabled ? '🔊' : '🔇';
        soundToggle.classList.toggle('muted', !soundEnabled);

        if (!soundEnabled) {
          stopWheelSound();
        }
      });

      phoneInput.addEventListener('input', e => {
        e.target.value = formatPhone(e.target.value);
      });

      wheelForm.addEventListener('submit', handleSpin);
      spinBtn.addEventListener('click', handleSpin);

      wheelSound.addEventListener('canplaythrough', () => {
        console.log('Звук загружен и готов к воспроизведению');
      });

      wheel.addEventListener('error', () => {
        showStatus('Не найден файл wheel2.png. Проверьте, что он лежит в папке сайта рядом с HTML-файлом.', 'error');
      });

      function scrollToWheelAnchor() {
        const hash = (window.location.hash || '').toLowerCase();
        if (hash !== '#koleso' && hash !== '#wheel') {
          return;
        }
        const target = document.getElementById('koleso');
        if (!target) {
          return;
        }
        requestAnimationFrame(function () {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      function init() {
        const stored = getStored();

        if (stored && typeof stored.prizeIndex === 'number') {
          stopSlowAnimation();
          applyWonState(stored);
        } else {
          applyReadyState();
        }

        scrollToWheelAnchor();
      }

      window.addEventListener('hashchange', scrollToWheelAnchor);

      init();
    })();
  </script>

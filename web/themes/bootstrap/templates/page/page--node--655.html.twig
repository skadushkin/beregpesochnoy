<script>
    // «загрузить еще» обрабатывается в bootstrap/js/main.js
    const sliderContent = document.querySelector('.video-catalog-items');
    const sliderItems = document.querySelectorAll('.video-catalog-item');
    const sliderDots = document.querySelectorAll('.slider-nav-dot');
    const gap = 20; // Гап между слайдами
    const slider = document.querySelector('.sliderr');

    function updateSlider(index) {
        let offset = 0;
        for (let i = 0; i < index; i++) {
            offset += sliderItems[i].offsetWidth + gap;
        }
        sliderContent.style.transform = `translateX(-${offset}px)`;
        document.querySelector('.slider-nav-dot.active').classList.remove('active');
        sliderDots[index].classList.add('active');
    }

    function handleResize() {
        if (window.innerWidth < 600) {
            slider.classList.remove('hidden'); // Показываем слайдер
            sliderDots.forEach((dot, index) => {
                dot.addEventListener('click', () => updateSlider(index));
            });
        } else {
            slider.classList.add('hidden'); // Скрываем слайдер
            sliderContent.style.transform = 'translateX(0)'; // Сбрасываем позицию слайдера
            sliderDots.forEach((dot) => {
                dot.removeEventListener('click', () => updateSlider(dot.dataset.slide));
            });
        }
    }

    // Инициализация при загрузке страницы
    handleResize();

    // Добавляем обработчик для изменения размера окна
    window.addEventListener('resize', handleResize);
</script>


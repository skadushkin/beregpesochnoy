        <a href="#" data-fancybox data-src="#isp{{ fields.nid.content|striptags|trim }}"><img src="/sites/default/files/img/ShortPlayIcon.svg" alt=""></a>
    </div>
    <div class="video-catalog-item-text">{{ fields.title.content }}</div>

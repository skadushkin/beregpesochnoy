{#
/**
 * @file
 * The views infinite scroll pager template.
 */
#}

{% if items.next %}
  <div class="catalog-items-showmore items-showmore-ipoteka">
    <ul{{ attributes.addClass('js-pager__items', 'pager') }}>
      <li class="pager__item">
        <a class="button" href="{{ items.next.href }}" title="{{ 'Load more items'|t }}" rel="next"><span>{{ options.button_text }}</span></a>
      </li>
    </ul>
  </div>
{% endif %}

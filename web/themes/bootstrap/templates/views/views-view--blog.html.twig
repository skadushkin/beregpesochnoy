<section class="bg1">
    <div class="first-container">
    <div class="container_w">
    <div class="first-container blog-container">

        <div class="container_w2">
            <div class="cameras-items">
            <div class="mobiles-blog-cats">
            {{ drupal_menu('kategorii-bloga') }}
            </div>
                {% if rows %}
                    {{ rows }}
                {% elseif empty %}
                    <div class="view-empty">
                        {{ empty }}
                    </div>
                {% endif %}



            </div>

            {% if pager %}
                {{ pager }}
            {% endif %}
            {% if attachment_after %}
                <div class="attachment attachment-after">
                    {{ attachment_after }}
                </div>
            {% endif %}
            {% if more %}
                {{ more }}
            {% endif %}

{#            <div class="catalog-items-showmore items-showmore-ipoteka">#}
{#                <span class="showmore-btn">загрузить еще</span>#}
{#            </div>#}

        </div>
        <div class="blog_sidebar">
        <div class="blog-search">
        <form action="/search/node" method="get" id="search-block-form" accept-charset="UTF-8" class="search-form search-block-form form-row">
        <button type="submit" class="blog-search-btn"><svg width="20" height="24" viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="8.48719" cy="8.48719" r="7.73719" stroke="#917357" stroke-width="1.5"/>
<line x1="12.7516" y1="15.0477" x2="18.8857" y2="22.9477" stroke="#917357" stroke-width="1.5" stroke-linecap="round"/>
</svg>
</button>
        <input placeholder="ПОИСК" title="Введите ключевые слова для поиска." data-drupal-selector="edit-keys" type="search" id="edit-keys" name="keys" value="" size="15" maxlength="128" class="form-search form-control">
        </form>
        </div>
        {{ drupal_menu('kategorii-bloga') }}
        {{ drupal_view('blog', 'block_1') }}
{{ drupal_view('populyarnye_proekty', 'block_1') }}
        

        {{ drupal_view('bootstrap_subtheme_search_form_narrow', 'block_1') }}
        </div>
    </div>
    </div>
    </div>
</section>

    <main class="landing">

        <!-- ═══ HERO — Figma 6873:1563 (Frame 1281) ═══ -->
        <section class="hero" id="top">
            <div class="hero__bg" aria-hidden="true"></div>

            <!-- Заголовок + статы поверх фото (Figma y373) -->
            <div class="cl hero__intro">
                <p class="hero__tagline">
                    <span class="t-white">Жилой комплекс </span><span class="t-accent">Берег Песочной</span><br>
                    <span class="t-accent">в экологически чистом </span><span class="t-white">районе Истры</span>
                </p>
                <div class="hero__eco-row">
                    <h1 class="hero__h1">
                        <span class="t-white">Идеальная </span><br>
                        <span class="t-accent">экосреда</span><br>
                        <span class="t-accent">для жизни</span>
                    </h1>
                    <div class="hero__side">
                        <div class="hero__glass">
                            <div class="hero__stats">
                                <div class="h-stat"><div class="h-stat__v">8 га</div><div class="h-stat__l">лесопарковой<br>зоны</div></div>
                                <div class="h-stat"><div class="h-stat__v">24/7</div><div class="h-stat__l">круглосуточная охрана</div></div>
                                <div class="h-stat"><div class="h-stat__v">5 мин</div><div class="h-stat__l">истринское<br>водохранилище</div></div>
                            </div>
                            <a href="/jk-bereg-pesochnoy.pdf" class="btn btn--fill btn--wide" download>Скачать презентацию <span class="btn-arrow" aria-hidden="true">→</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- ═══ О ПОСЕЛКЕ — карта + текст (Figma Frame 1267) ═══ -->
        <section class="section hero-map" id="settlement">
            <div class="cl">
                <div class="hero__map-row">
                    <div class="hero__map">
                        <img src="{{ lv2_img }}hero-pattern2.svg" alt="Карта поселка" class="hero__map-img">
                    </div>
                    <div class="hero__about">
                        <p>Коттеджный поселок «Берег Песочной» расположен в одном из самых красивых и экологически чистых районов Подмосковья — в Истринском районе, всего в 45 километрах от Москвы. Жизнь в «Берег Песочной» прекрасно подходит для того, чтобы уйти от городской суеты ради чистой природы и здорового образа жизни.</p>
                        <p>Поселок создан в форме загородного жилого квартала. Земля, на которой он расположен, относится к категории земель населенных пунктов. У каждого дома есть свой почтовый адрес, а жители поселка могут воспользоваться правом прописки. Площадь поселка — 28 гектаров.</p>
                        <button type="button" class="btn btn--fill open-lv2-tour-modal">записаться на экскурсию <span class="btn-arrow" aria-hidden="true">→</span></button>
                    </div>
                </div>
            </div>
        </section>


        <!-- ═══ ИНФРАСТРУКТУРА — слайдер 3 кадра на всю ширину (Figma 6870:9769) ═══ -->

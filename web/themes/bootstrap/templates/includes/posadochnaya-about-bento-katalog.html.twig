{# About + cards — SEO-версия Figma 7140:1676 #}
{% set p = posadochnaya|default({}) %}

{% if p.about_title or p.about_text or p.bento is not empty %}
<section class="posadochnaya-about">
    <div class="container">
        <div class="in-container">
            {% if p.about_title or p.about_text %}
            <div class="posadochnaya-about__head">
                {% if p.about_title %}
                    <h2 class="posadochnaya-about__title">{{ p.about_title }}</h2>
                {% endif %}
                {% if p.about_text %}
                    <div class="posadochnaya-about__text regular-desc">{{ p.about_text|raw }}</div>
                {% endif %}
            </div>
            {% endif %}

            {% if p.bento is not empty %}
            <div class="posadochnaya-features">
                {% for item in p.bento %}
                <article class="posadochnaya-features__card">
                    {% if item.image %}
                    <div class="posadochnaya-features__photo">
                        <img src="{{ item.image }}" alt="{{ item.title|striptags }}">
                    </div>
                    {% endif %}
                    {% if item.title or item.text %}
                    <div class="posadochnaya-features__body">
                        {% if item.title %}
                            <h3 class="posadochnaya-features__title">{{ item.title }}</h3>
                        {% endif %}
                        {% if item.text %}
                            {{ item.text|raw }}
                        {% endif %}
                    </div>
                    {% endif %}
                </article>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}

{# test2: продающая главная «Берег Песочной» по мастер-промпту. #}
{% set b = bereg|default({}) %}

<div class="landing-dev2-root">
  {% include '@bootstrap/includes/bp/header.html.twig' with { bp_transparent: true, bereg: b } %}

  <main>
    {% include '@bootstrap/includes/bp/sections/hero.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/about.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/masterplan.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/infrastructure.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/property.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/waterfront.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/gallery.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/location.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/viewing-cta.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/construction.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/lead-mid.html.twig' with { form_source: 'TEST2 главная — подборка' } %}
    {% include '@bootstrap/includes/bp/sections/faq.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/concierge.html.twig' %}
    {% include '@bootstrap/includes/bp/sections/final-cta.html.twig' with { form_source: 'TEST2 главная — просмотр' } %}
  </main>

  {% include '@bootstrap/includes/bp/footer.html.twig' %}

  {% include '@bootstrap/includes/landing-tour-modal.html.twig' with {
    tour_modal_label: 'Берег Песочной',
    tour_modal_source: 'TEST2 лендинг — экскурсия'
  } %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Residence",
    "name": "ЖК Берег Песочной",
    "url": "https://test2.beregpesochnoy.ru/",
    "telephone": "{{ b.phone_display|default('+7 (495) 186-50-88') }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ b.address_line|default('Лесная улица, 1') }}",
      "addressLocality": "Истра",
      "addressRegion": "Московская область",
      "addressCountry": "RU"
    }
  }
  </script>
</div>

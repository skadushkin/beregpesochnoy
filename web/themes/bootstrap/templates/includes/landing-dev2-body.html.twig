<main class="ri">
  <section class="ri-hero">
    <div class="ri-hero__media" style="background-image:url('{{ photo }}bereg-foto1.webp')"></div>
    <div class="ri-hero__shade"></div>
    <div class="ri-wrap ri-hero__content">
      <div class="ri-chips">
        <span>45 минут от Москвы</span>
        <span>Истринское водохранилище</span>
      </div>
      <p class="ri-hero__eyebrow">Дома для жизни круглый год</p>
      <h1>Идеальная экосреда<br>для жизни</h1>
      <p class="ri-hero__lead">«Берег Песочной» в Истринском районе: природа, парк и отдых у воды. Готовые дома, городские коммуникации и охрана 24/7.</p>
      <div class="ri-hero__actions">
        <button type="button" class="ri-btn ri-btn--light open-lv2-tour-modal">Записаться на показ</button>
        <a class="ri-btn ri-btn--ghost" href="/jk-bereg-pesochnoy.pdf" download>Получить презентацию</a>
      </div>
    </div>
  </section>

  <section class="ri-section" id="about">
    <div class="ri-wrap ri-about">
      <div class="ri-about__text">
        <p class="ri-kicker">О проекте</p>
        <h2>Курортный формат загородной жизни с городским комфортом</h2>
        <p><strong>«Берег Песочной»</strong> — коттеджный посёлок рядом с рекой Песочная и в нескольких минутах от Истринского водохранилища. Создан и для отдыха, и для постоянной жизни: городские коммуникации, охрана, прописка и почтовый адрес у каждого дома.</p>
        <p>Площадь посёлка — 28 гектаров, плюс 8 га лесопарковой зоны. Земля относится к землям населённых пунктов.</p>
        <a class="ri-btn ri-btn--accent" href="/jk-bereg-pesochnoy.pdf" download>Получить презентацию</a>
      </div>
      <ul class="ri-stats">
        <li><b>28 га</b><span>площадь посёлка</span></li>
        <li><b>8 га</b><span>лесопарк</span></li>
        <li><b>45 мин</b><span>до МКАД</span></li>
        <li><b>5 мин</b><span>до водохранилища</span></li>
      </ul>
    </div>
  </section>

  <section class="ri-section ri-section--tight" id="today">
    <div class="ri-wrap">
      <p class="ri-kicker">Фотографии посёлка</p>
      <h2>Посёлок сегодня</h2>
    </div>
    <div class="ri-mosaic ri-wrap">
      <figure class="ri-mosaic__large"><img src="{{ photo }}bereg-foto2.webp" alt="Посёлок Берег Песочной" width="960" height="640"></figure>
      <figure><img src="{{ photo }}bereg-foto3.webp" alt="" width="480" height="320" loading="lazy"></figure>
      <figure><img src="{{ photo }}bereg-foto4.webp" alt="" width="480" height="320" loading="lazy"></figure>
      <figure><img src="{{ photo }}bereg-foto5.webp" alt="" width="480" height="320" loading="lazy"></figure>
      <figure><img src="{{ photo }}slider2.webp" alt="" width="480" height="320" loading="lazy"></figure>
    </div>
  </section>

  <section class="ri-section" id="catalog">
    <div class="ri-wrap">
      <div class="ri-catalog__head">
        <div>
          <p class="ri-kicker">Каталог домов</p>
          <h2>Выберите дом для своей семьи</h2>
        </div>
        <nav class="ri-pills" data-lv2-catalog-tabs aria-label="Тип дома">
          <button type="button" data-tab="1" data-catalog-href="/kupit-dom-v-kottedzhnom-poselke?type=2">Готовые дома</button>
          <button type="button" class="is-active" data-tab="2" data-catalog-href="/kupit-dom-v-kottedzhnom-poselke?type=3" aria-selected="true">Строящиеся</button>
          <button type="button" data-tab="4" data-catalog-href="/taunhausy">Таунхаусы</button>
        </nav>
      </div>
      <div class="ri-catalog__houses" data-lv2-catalog-panels>
        <div class="ri-catalog__panel" data-tab-panel="1" hidden>{{ drupal_view('gotovye_doma', 'block_6') }}</div>
        <div class="ri-catalog__panel is-active" data-tab-panel="2">{{ drupal_view('gotovye_doma', 'block_3') }}</div>
        <div class="ri-catalog__panel" data-tab-panel="4" hidden>{{ drupal_view('gotovye_doma', 'block_4') }}</div>
      </div>
      <div class="ri-catalog__cta">
        <a href="/kupit-dom-v-kottedzhnom-poselke?type=3" class="ri-btn ri-btn--accent" data-lv2-catalog-more>Смотреть весь каталог</a>
      </div>
    </div>
  </section>

  <section class="ri-section ri-included">
    <div class="ri-wrap">
      <p class="ri-kicker">Понятная комплектация</p>
      <h2>Что вы получаете вместе с домом</h2>
      <p class="ri-lead">У домов единая базовая комплектация: тёплый контур, коммуникации и подготовленный участок.</p>
      <div class="ri-included__grid">
        <article>
          <p class="ri-num">01 / Дом</p>
          <h3>Тёплый контур</h3>
          <p>Дом в комплектации «тёплый контур», окна REHAU 70-й серии и входная дверь с терморазрывом.</p>
        </article>
        <article>
          <p class="ri-num">02 / Коммуникации</p>
          <h3>Основа для комфортной жизни</h3>
          <p>Канализация, электричество 10 кВт, водопровод и оптоволоконный интернет. Газ — по границе участка.</p>
        </article>
        <article>
          <p class="ri-num">03 / Участок</p>
          <h3>Своё пространство снаружи</h3>
          <p>Забор по периметру, отмостка из брусчатки и подготовленное машино-место. Расположение — на генплане.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ri-section" id="genplan">
    <div class="ri-wrap ri-genplan">
      <div class="ri-genplan__copy">
        <p class="ri-kicker">Генплан</p>
        <h2>Приватная территория, граничащая с лесом</h2>
        <p>Нажмите на карту, чтобы открыть интерактивный генплан: фото, цена и характеристики домов. Значки показывают инфраструктуру посёлка.</p>
        <a class="ri-btn ri-btn--accent" href="/karta">Открыть генплан</a>
      </div>
      <a href="/karta" class="ri-genplan__map">
        <img src="{{ img }}hero-pattern2.svg" alt="Карта посёлка Берег Песочной" width="720" height="520">
      </a>
    </div>
  </section>

  <section class="ri-section" id="infra">
    <div class="ri-wrap">
      <p class="ri-kicker">Инфраструктура</p>
      <h2>Всё необходимое для обычного дня</h2>
      <div class="ri-infra">
        <article>
          <h3>У воды</h3>
          <p>Река Песочная, 5 минут до Истринского водохранилища, прогулочные маршруты.</p>
        </article>
        <article>
          <h3>Спорт</h3>
          <p>Парк 8 га, площадки и маршруты для прогулок и тренировок на свежем воздухе.</p>
        </article>
        <article>
          <h3>Для детей</h3>
          <p>Детские площадки на территории и школы Истры в короткой доступности.</p>
        </article>
        <article>
          <h3>Коммуникации</h3>
          <p>Электричество, вода, канализация, газ и интернет — как в городе.</p>
        </article>
        <article>
          <h3>Безопасность</h3>
          <p>Круглосуточная охрана и закрытая территория без сквозного трафика.</p>
        </article>
        <article>
          <h3>Рядом</h3>
          <p>Магазины, клиники и сервисы Истры — около 10 минут на машине.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ri-water">
    <div class="ri-water__media" style="background-image:url('{{ photo }}slider3.webp')"></div>
    <div class="ri-wrap ri-water__copy">
      <p class="ri-kicker ri-kicker--light">Водная инфраструктура</p>
      <h2>Не просто вид на воду — доступ к ней</h2>
      <p>Посёлок стоит на берегу реки Песочная. Истринское водохранилище — в пяти минутах: пляж, прогулки, тишина без городской суеты.</p>
      <a class="ri-btn ri-btn--light" href="/pontonnyj-plyazh">Подробнее</a>
    </div>
  </section>

  <section class="ri-section" id="formats">
    <div class="ri-wrap">
      <p class="ri-kicker">Форматы</p>
      <h2>Место, где вся семья собирается вместе</h2>
      <div class="ri-formats">
        <a href="/taunhausy" class="ri-format">
          <img src="{{ photo }}bereg-foto3.webp" alt="Таунхаусы" loading="lazy">
          <span>Таунхаусы</span>
        </a>
        <a href="/kupit-dom-v-kottedzhnom-poselke" class="ri-format">
          <img src="{{ photo }}bereg-foto2.webp" alt="Частные дома" loading="lazy">
          <span>Частные дома</span>
        </a>
        <a href="/rezidents" class="ri-format">
          <img src="{{ photo }}bereg-foto4.webp" alt="VIP-резиденции" loading="lazy">
          <span>VIP-резиденции</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ri-section ri-park">
    <div class="ri-wrap">
      <p class="ri-kicker">Парк и площадки</p>
      <h2>Парк рядом с домом</h2>
      <ul class="ri-park__stats">
        <li><b>8 га</b><span>ландшафтного парка</span></li>
        <li><b>Пруд</b><span>с фонтаном</span></li>
        <li><b>Детские</b><span>площадки</span></li>
        <li><b>Спорт</b><span>на свежем воздухе</span></li>
      </ul>
    </div>
  </section>

  <section class="ri-section" id="gallery">
    <div class="ri-wrap">
      <p class="ri-kicker">Галерея</p>
      <h2>Архитектура и среда в деталях</h2>
      <div class="ri-gallery">{{ drupal_view('novyy_slayder1', 'block_3') }}</div>
    </div>
  </section>

  <section class="ri-section" id="buy">
    <div class="ri-wrap">
      <p class="ri-kicker">Как купить</p>
      <h2>Способы покупки</h2>
      <div class="ri-buy">
        <article>
          <h3>Рассрочка</h3>
          <p class="ri-buy__num">0%</p>
          <p>Первый взнос и срок согласуем индивидуально.</p>
        </article>
        <article>
          <h3>Ипотека</h3>
          <p class="ri-buy__num">от 6%</p>
          <p>Все виды ипотеки, включая семейную. Помощь с оформлением.</p>
        </article>
        <article>
          <h3>Трейд-ин</h3>
          <p class="ri-buy__text">Поможем продать текущую недвижимость и зачесть средства в сделку.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ri-section" id="steps">
    <div class="ri-wrap">
      <p class="ri-kicker">Ваш следующий шаг</p>
      <h2>От знакомства с посёлком — к выбору дома</h2>
      <div class="ri-steps">
        <article>
          <p class="ri-num">01</p>
          <h3>Выберите варианты</h3>
          <p>Сравните готовые и строящиеся дома. В карточках есть фотографии, планировки и расположение лота.</p>
        </article>
        <article>
          <p class="ri-num">02</p>
          <h3>Посмотрите вживую</h3>
          <p>Оцените комнаты, свет, участок и расстояния до соседних домов. Обсудите комплектацию и готовность.</p>
        </article>
        <article>
          <p class="ri-num">03</p>
          <h3>Обсудите детали</h3>
          <p>Уточните документы, условия покупки и этапы передачи. Отделку можно заказать в архитектурном ателье.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ri-section" id="faq">
    <div class="ri-wrap ri-faq">
      <div>
        <p class="ri-kicker">Перед просмотром</p>
        <h2>Что стоит знать о выборе дома</h2>
      </div>
      <div class="ri-faq__list">
        <details open>
          <summary>Чем готовый дом отличается от дома, готового к заселению?</summary>
          <p>Смотрите комплектацию конкретного лота. «Тёплый контур» не означает завершённую внутреннюю отделку. Состав предложения обсудим перед просмотром.</p>
        </details>
        <details>
          <summary>Можно ли заказать внутреннюю отделку?</summary>
          <p>Да. Доступны черновая отделка, White box и дизайн интерьера. Объём работ согласовывается отдельно для выбранного дома.</p>
        </details>
        <details>
          <summary>Как выбрать расположение участка?</summary>
          <p>Посмотрите лот на генплане, затем оцените его вживую: соседние дома, подъезд, виды из окон и путь до общих зон посёлка.</p>
        </details>
        <details>
          <summary>Как записаться на выбранный дом?</summary>
          <p>Оставьте телефон в форме или нажмите «Записаться на показ». Согласуем удобное время экскурсии.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="ri-section" id="location">
    <div class="ri-wrap ri-location">
      <div>
        <p class="ri-kicker">Локация</p>
        <h2>Тишина и природа — рядом с Москвой</h2>
        <p>45 минут до МКАД по Новориге. Истра, магазины и школы — около 10 минут. Сам посёлок без транзитного трафика.</p>
        <ul class="ri-roads">
          <li>Новорижское шоссе</li>
          <li>Волоколамское</li>
          <li>М-11 «Нева»</li>
        </ul>
        <a class="ri-btn ri-btn--accent" href="https://yandex.ru/maps/213/moscow/?ll=37.093746%2C55.877213&mode=routes&rtext=55.818974%2C37.390776~55.959175%2C36.947689&rtt=auto" target="_blank" rel="noopener">Построить маршрут</a>
      </div>
      <div class="ri-location__card">
        <b>45 мин</b>
        <span>от МКАД на машине</span>
        <img src="{{ photo }}bereg-foto5.webp" alt="" loading="lazy">
      </div>
    </div>
  </section>

  <section class="ri-cta" id="contacts">
    <div class="ri-wrap ri-cta__grid">
      <div>
        <p class="ri-kicker ri-kicker--light">Контакты</p>
        <h2>Приезжайте понять, подходит ли вам жизнь здесь</h2>
        <p>Расскажем про ипотеку, покажем дома и согласуем экскурсию.</p>
        <a class="ri-cta__phone" href="tel:+74951865088">+7 (495) 186-50-88</a>
      </div>
      <form class="ri-form lv2-cta-form" action="#" method="post" novalidate>
        <input type="hidden" name="source" value="Лендинг TEST2 / residences + aibereg">
        <label><input type="text" name="name" placeholder="Ваше имя" autocomplete="name" required></label>
        <label><input type="tel" name="phone" class="phone-field-mask" placeholder="Ваш телефон" autocomplete="tel" required></label>
        <label class="ri-form__agree">
          <input type="checkbox" name="agree" required>
          <span>Согласен с <a href="/policy/">политикой конфиденциальности</a></span>
        </label>
        <button type="button" class="ri-btn ri-btn--accent" id="lv2-cta-send">Отправить</button>
        <div class="popup-success">Заявка отправлена. Спасибо.</div>
      </form>
    </div>
  </section>
</main>


<main class="ponton istra landing">

    <!-- ═══ HERO ═══ -->
    <section class="ponton-hero istra-hero" id="top">
        <div class="ponton-hero__bg" aria-hidden="true">
            <img src="{{ pt_img }}hero-house-401b81.png" alt="" width="1920" height="686">
        </div>
        <div class="cl ponton-hero__content">
            <div class="ponton-hero__main">
                <div class="ponton-hero__copy">
                    <h1 class="ponton-hero__title">Коттеджный поселок с газом</h1>
                    <div class="istra-hero__text">
                        <p class="ponton-hero__lead">КП «Берег Песочной» — коттеджный поселок с магистральным газом на Новой Риге. Газ подведен к границе каждого участка, а заведение газа в дом проходит официально через местную газораспределительную организацию.</p>
                        <p>Магистральный газ — один из ключевых факторов для постоянного проживания за городом. В «Береге Песочной» газовая инфраструктура уже предусмотрена на уровне поселка: покупателю не нужно начинать с долгого поиска технической возможности подключения. Процесс заведения газа в дом проходит быстро и официально, а по условиям проекта может быть предусмотрена компенсация стоимости подключения. Подробности уточняйте у менеджера.</p>
                    </div>
                    <div class="ponton-hero__actions">
                        <button type="button" class="btn btn--white open-lv2-tour-modal">Уточнить подключение газа</button>
                        <a href="#catalog" class="ponton-hero__link">Посмотреть дома с газом</a>
                    </div>
                </div>
                <div class="ponton-hero__stats">
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Газ у участка</strong>
                        <span class="ponton-stat__l">магистральный газ подведен к границе каждого участка</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Официальное подключение</strong>
                        <span class="ponton-stat__l">заведение газа в дом через местную ГРО</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Быстрый процесс</strong>
                        <span class="ponton-stat__l">подключение проходит по понятному регламенту</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Компенсация</strong>
                        <span class="ponton-stat__l">возможна компенсация стоимости заведения газа в дом</span>
                    </article>
                </div>
            </div>
        </div>
    </section>


    <!-- ═══ ПОЧЕМУ ВАЖЕН + КАРТОЧКИ ═══ -->
    <section class="section ponton-about istra-about" id="about">
        <div class="cl section__inner ponton-about__inner">
            <div class="ponton-about__head">
                <h2 class="h2 ponton-about__title">Почему газ важен для жизни за городом</h2>
                <div class="istra-prose">
                    <p>Коттеджный поселок с газом выбирают покупатели, которые рассматривают дом не как сезонную дачу, а как полноценное место для жизни круглый год. Газ влияет на отопление, горячую воду, бытовой комфорт и расходы на содержание дома. Поэтому наличие магистрального газа становится одним из главных вопросов при выборе поселка.</p>
                    <p>Если газ не подведен к поселку или участку, покупателю приходится отдельно разбираться с технической возможностью подключения, сроками, согласованиями и затратами. Это может усложнить покупку и добавить неопределенность еще до начала жизни в доме.</p>
                    <p>В КП «Берег Песочной» газ подведен к границе каждого участка. Это важное преимущество для тех, кто хочет заранее понимать инженерную базу будущего дома и не сталкиваться с неопределенностью после покупки.</p>
                </div>
            </div>

            <div class="istra-features">
                <article class="istra-features__card">
                    <div class="istra-features__photo">
                        <img src="{{ lv2_img }}family-townhouse.png" alt="Магистральный газ">
                    </div>
                    <div class="istra-features__body">
                        <h3 class="istra-features__title">Магистральный газ</h3>
                        <p>Газовая инфраструктура предусмотрена на уровне поселка и подведена к границе каждого участка.</p>
                    </div>
                </article>
                <article class="istra-features__card">
                    <div class="istra-features__photo">
                        <img src="{{ pt_img }}bento-comfort.png" alt="Подключение через ГРО">
                    </div>
                    <div class="istra-features__body">
                        <h3 class="istra-features__title">Подключение через ГРО</h3>
                        <p>Заведение газа в дом выполняется официально через местную газораспределительную организацию.</p>
                    </div>
                </article>
                <article class="istra-features__card">
                    <div class="istra-features__photo">
                        <img src="{{ lv2_img }}private-house.png" alt="Для жизни круглый год">
                    </div>
                    <div class="istra-features__body">
                        <h3 class="istra-features__title">Для жизни круглый год</h3>
                        <p>Газ помогает организовать комфортное отопление и бытовые сценарии в доме в любое время года.</p>
                    </div>
                </article>
                <article class="istra-features__card">
                    <div class="istra-features__photo">
                        <img src="{{ pt_img }}bento-activities.png" alt="Условия подключения">
                    </div>
                    <div class="istra-features__body">
                        <h3 class="istra-features__title">Условия подключения</h3>
                        <p>По проекту может быть предусмотрена компенсация стоимости заведения газа в дом. Подробности — у менеджера.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>


    <!-- ═══ КАТАЛОГ ═══ -->
    <section class="section lv2-catalog ponton-catalog istra-catalog" id="catalog">
        <div class="cl section__inner">
            <div class="ponton-catalog__head">
                <h2 class="h2 h2--center ponton-catalog__h2">
                    <span class="t-merit t-white">Дома в поселке </span><br>
                    <span class="t-dark">с магистральным газом</span>
                </h2>
                <div class="ponton-scheme__pills ponton-catalog__pills">
                    <a href="/kupit-dom-v-kottedzhnom-poselke" class="ponton-pill is-active">Все</a>
                    <a href="/kupit-dom-v-kottedzhnom-poselke?type=2" class="ponton-pill">Готовые дома</a>
                    <a href="/kupit-dom-v-kottedzhnom-poselke?type=3" class="ponton-pill">Cтроящиеся дома</a>
                    <a href="/taunhausy" class="ponton-pill">Таунхаусы</a>
                    <a href="/uchastok-s-podryadom-v-podmoskovye" class="ponton-pill">Дома с подрядом</a>
                </div>
            </div>
            <div class="lv2-catalog__houses">
                {{ drupal_view('gotovye_doma', 'block_6') }}

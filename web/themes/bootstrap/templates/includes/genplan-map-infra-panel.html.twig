{# Инфраструктура поселка — Figma 7484:3258 #}
{% set gp2_img = '/themes/bootstrap/landing-v2/img/genplan-v2/' %}
<aside class="genplan-infra-panel" aria-label="Инфраструктура поселка">
  <button type="button" class="genplan-infra-panel__close" data-gp-infra-close aria-label="Закрыть">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M0.353516 0.353577L17.3535 17.3536M0.646409 17.3536L17.6464 0.353577" stroke="#FFFBF3"/>
    </svg>
  </button>
  <h3 class="genplan-infra-panel__title">Инфраструктура поселка</h3>
  <div class="genplan-infra-panel__grid">
    <div class="genplan-infra-panel__row">
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-sunbed.svg" alt="" width="32" height="32">
        <span class="genplan-infra-panel__label">Песчаная береговая линия</span>
      </div>
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-park.svg" alt="" width="25" height="32">
        <span class="genplan-infra-panel__label">Детская площадка</span>
      </div>
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-kids.svg" alt="" width="33" height="32">
        <span class="genplan-infra-panel__label">Спортивная площадка</span>
      </div>
    </div>
    <div class="genplan-infra-panel__row">
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-activity.svg" alt="" width="32" height="32">
        <span class="genplan-infra-panel__label">Зона барбекю</span>
      </div>
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-water.svg" alt="" width="32" height="32">
        <span class="genplan-infra-panel__label">Выход к воде</span>
      </div>
      <div class="genplan-infra-panel__item">
        <img class="genplan-infra-panel__icon" src="{{ gp2_img }}infra-parking.svg" alt="" width="32" height="32">
        <span class="genplan-infra-panel__label">Парковка</span>
      </div>
    </div>
  </div>
</aside>

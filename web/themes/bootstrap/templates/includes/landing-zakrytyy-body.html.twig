                        <button type="button" class="btn btn--white open-lv2-tour-modal">Записаться на экскурсию</button>
                        <a href="#catalog" class="ponton-hero__link">Посмотреть дома</a>
                    </div>
                </div>
                <div class="ponton-hero__stats">
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Закрытая территория</strong>
                        <span class="ponton-stat__l">приватная среда</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Охрана 24/7</strong>

{# SEO-лендинг «КП на Новой Риге». Node 851. /kottedzhnyy-poselok-novaya-riga/ #}
{% set pt_img = '/themes/bootstrap/landing-ponton/img/' %}

<main class="ponton istra landing">

    <!-- ═══ HERO ═══ -->
    <section class="ponton-hero istra-hero" id="top">
        <div class="ponton-hero__bg" aria-hidden="true">
            <img src="{{ pt_img }}hero-house-401b81.png" alt="" width="1920" height="686">
        </div>
        <div class="cl ponton-hero__content">
            <div class="ponton-hero__main">
                <div class="ponton-hero__copy">
                    <h1 class="ponton-hero__title">Коттеджный поселок на Новой Риге</h1>
                    <div class="istra-hero__text">
                        <p class="ponton-hero__lead">КП «Берег Песочной» — поселок бизнес-класса в Истринском районе, в 45&nbsp;км от МКАД. Закрытая территория, собственный ландшафтный парк, река Песочная, городские коммуникации и дома для постоянного проживания на Новорижском направлении.</p>
                    </div>
                    <div class="ponton-hero__actions">
                        <button type="button" class="btn btn--white open-lv2-tour-modal">Записаться на экскурсию</button>
                        <a href="#catalog" class="ponton-hero__link">Посмотреть дома</a>
                    </div>
                </div>
                <div class="ponton-hero__stats">
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">45 км</strong>
                        <span class="ponton-stat__l">от МКАД по Новорижскому направлению</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">10 минут</strong>
                        <span class="ponton-stat__l">до города Истра и городской инфраструктуры</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">8 гектаров</strong>
                        <span class="ponton-stat__l">собственного ландшафтного парка</span>
                    </article>
                    <article class="ponton-stat">
                        <strong class="ponton-stat__v">Для жизни</strong>
                        <span class="ponton-stat__l">газ, канализация, вода, интернет и охрана</span>
                    </article>
                </div>
            </div>
        </div>
    </section>


    <!-- ═══ НОВАЯ РИГА ═══ -->
    <section class="section ponton-about istra-about" id="about">
        <div class="cl section__inner ponton-about__inner">
            <div class="ponton-about__head">
                <h2 class="h2 ponton-about__title">Новая Рига как направление для загородной жизни</h2>
                <div class="istra-prose">
                    <p>Новая Рига — одно из самых востребованных направлений Подмосковья для покупки загородного дома. Его выбирают за удобную дорогу от Москвы, статусную среду, экологичное окружение и близость к природным локациям Истринского района. Для покупателя коттеджного поселка важны не только километры от МКАД, но и то, какой образ жизни формирует локация: насколько удобно добираться, где находится ближайшая городская инфраструктура, есть ли рядом вода, лес, прогулочные маршруты и места для отдыха.</p>
                    <p>КП «Берег Песочной» расположен на Новорижском направлении, примерно в 45&nbsp;км от МКАД и в 10&nbsp;минутах от Истры. Такое расположение позволяет рассматривать поселок не только как дачный формат, но и как место для постоянного проживания: рядом есть школы, детские сады, поликлиники, магазины и спортивные объекты, а сама территория поселка сохраняет ощущение приватной загородной среды.</p>
                </div>
            </div>
        </div>
    </section>


    <!-- ═══ ПОСЕЛОК С ПАРКОМ ═══ -->
    <section class="section istra-text" id="environment">
        <div class="cl section__inner istra-text__inner">
            <h2 class="h2 h2--center">КП «Берег Песочной»: поселок с парком, рекой и готовой средой</h2>
            <div class="istra-prose">
                <p>«Берег Песочной» — это не просто набор домов и участков на Новой Риге, а сформированная загородная среда для жизни. В поселке предусмотрена закрытая охраняемая территория, видеонаблюдение, контроль доступа, магистральный газ, центральное энергоснабжение, централизованная канализация, собственный водозаборный узел и оптоволоконный интернет. Первая очередь уже сдана и заселена, поэтому будущие жители могут приехать, увидеть территорию, оценить окружение и выбрать подходящий формат объекта.</p>
                <p>Одно из главных преимуществ поселка — собственный ландшафтный парк площадью 8&nbsp;гектаров. Здесь высажены деревья, обустроены прогулочные и велосипедные дорожки, зоны отдыха, пруд с фонтаном и пространства для семейного досуга. Вдоль южной границы поселка протекает река Песочная, а в нескольких минутах езды находится Истринское водохранилище. Это усиливает сценарии загородной жизни: прогулки, отдых у воды, спорт, семейные выходные и спокойные вечера за городом.</p>
            </div>
        </div>
    </section>


    <!-- ═══ КАТАЛОГ ═══ -->
    <section class="section lv2-catalog ponton-catalog istra-catalog" id="catalog">
        <div class="cl section__inner">
            <div class="ponton-catalog__head">
                <h2 class="h2 h2--center ponton-catalog__h2">
                    <span class="t-merit t-white">Дома и участки </span><br>
                    <span class="t-dark">в КП «Берег Песочной»</span>
                </h2>
                <p class="istra-catalog__lead">В поселке можно рассмотреть готовые дома, строящиеся объекты и участки с подрядом. Изучите доступные варианты, сравните площадь дома и участка, статус готовности, расположение на генплане и условия покупки.</p>
                <div class="ponton-scheme__pills ponton-catalog__pills">
                    <a href="/kupit-dom-v-kottedzhnom-poselke" class="ponton-pill is-active">Все</a>
                    <a href="/kupit-dom-v-kottedzhnom-poselke?type=2" class="ponton-pill">Готовые дома</a>
                    <a href="/kupit-dom-v-kottedzhnom-poselke?type=3" class="ponton-pill">Cтроящиеся дома</a>
                    <a href="/taunhausy" class="ponton-pill">Таунхаусы</a>
                    <a href="/uchastok-s-podryadom-v-podmoskovye" class="ponton-pill">Дома с подрядом</a>
                </div>
            </div>
            <div class="lv2-catalog__houses">
                {{ drupal_view('gotovye_doma', 'block_6') }}
            </div>
            <div class="ponton-catalog__cta">
                <a href="/kupit-dom-v-kottedzhnom-poselke" class="btn btn--white">Смотреть весь каталог <span class="btn-arrow">→</span></a>
            </div>
        </div>
    </section>


    <!-- ═══ FAQ ═══ -->
    <section class="section istra-faq" id="faq">
        <div class="cl section__inner istra-faq__inner">
            <h2 class="h2 h2--center">Частые вопросы</h2>
            <div class="istra-faq__list">
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Где находится КП «Берег Песочной» на Новой Риге?</summary>
                    <div class="istra-faq__a"><p>Поселок расположен в Истринском районе Московской области, на Новорижском направлении, примерно в 45&nbsp;км от МКАД. До города Истра — около 10&nbsp;минут на автомобиле.</p></div>
                </details>
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Почему покупатели выбирают Новорижское направление?</summary>
                    <div class="istra-faq__a"><p>Новая Рига ценится за удобный выезд из Москвы, развитую инфраструктуру направления, экологичное окружение и статусную загородную среду. Для семей это сочетание доступности города и жизни в частном доме.</p></div>
                </details>
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Какие дома и участки доступны в поселке?</summary>
                    <div class="istra-faq__a"><p>В КП «Берег Песочной» представлены готовые дома, объекты на стадии строительства и участки с подрядом. Актуальные предложения — в <a href="#catalog">каталоге на странице</a>.</p></div>
                </details>
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Можно ли жить в поселке круглый год?</summary>
                    <div class="istra-faq__a"><p>Да. Поселок рассчитан на постоянное проживание: магистральный газ, центральное энергоснабжение, канализация, водоснабжение, оптоволоконный интернет, охрана и видеонаблюдение.</p></div>
                </details>
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Что есть на территории кроме домов?</summary>
                    <div class="istra-faq__a"><p>Ландшафтный парк 8&nbsp;га с дорожками и зонами отдыха, река Песочная вдоль границы поселка, закрытая охраняемая территория. Рядом — Истринское водохранилище и инфраструктура Истры.</p></div>
                </details>
                <details class="istra-faq__item">
                    <summary class="istra-faq__q">Можно ли приехать на экскурсию?</summary>
                    <div class="istra-faq__a"><p>Да, запишитесь на экскурсию — покажем территорию, парк, доступные дома и участки, расскажем об условиях покупки и ответим на вопросы.</p></div>
                </details>
            </div>
        </div>
    </section>

    {{ drupal_entity('block_content', '44') }}

    {% include '@bootstrap/includes/landing-tour-modal.html.twig' with {
        tour_modal_label: 'Берег Песочной',
        tour_modal_source: 'Лендинг КП на Новой Риге — экскурсия'
    } %}

</main>

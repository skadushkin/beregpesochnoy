          // iframeClose.classList.add('iframe-close');
          // iframeClose.addEventListener('click', () => {
          //   body.removeChild(iframeWrapper);
          //   body.classList.remove('iframe-offset');
          // })
          // iframeWrapper.append(iframeClose);
          // body.append(iframeWrapper);
          // body.classList.add('iframe-offset');

          // const localStorageInterval = setInterval(() => {
          //   const leftPosition = localStorage.getItem('vr-tour-popup-left');
          //   if(leftPosition) {
          //     iframe.style.left = -leftPosition + 'px';
          //   }
          // }, 100)
      }

      const maxIterations = 200;
      let iterations = 0;
      const interval = setInterval(() => {
          const openVrTourLink = document.querySelector('#gpt_push .new_tour');
          if(openVrTourLink) {
              openVrTourLink.addEventListener('click', (e) => {
                  e.preventDefault();
                  // openVrTour(openVrTourLink.getAttribute('href') + '&iframe=1');
                  openVrTour(openVrTourLink.getAttribute('href'));
              });
              clearInterval(interval);
          }
          iterations++;
          if(iterations >= maxIterations) {
              clearInterval(interval);
          }
      }, 100);

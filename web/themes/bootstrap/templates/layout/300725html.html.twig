  <link rel="stylesheet" href="https://beregpesochnoy.ru/sites/default/files/assets/css/vrTour.css">
  <script>
      const path = window.location.pathname;
      let trimmedInput = path.replace(/^\/|\/$/g, '');
      let formattedInput = trimmedInput.replace(/\//g, '-');
      let url = new URL(window.location.href);
      let params = new URLSearchParams(url.search);
      let configNum = params.get('vrtour')
      if(configNum != null && configNum != '1') formattedInput += '-'+configNum;
      let configName = `config-${formattedInput}.json`;
      if(configName.search('config-.json') == 0) configName = 'config.json';
      if(configName.search(`config--${configNum}.json`) == 0) configName = `config-${configNum}.json`;

      const localStep = localStorage.getItem(`vr-tour-config-${configName.replace('.json', '')}`);
      if(!localStep) {
          localStorage.setItem(`vr-tour-config-${configName.replace('.json', '')}`, 0);
      }

      const SITE_TEMPLATE_PATH = "https://beregpesochnoy.ru/sites/default/files/assets/js/vrtour/";
      fetch(`${SITE_TEMPLATE_PATH}${configName}`)
          .then(response => {
              if (!response.ok) {
                  throw new Error('Network response was not ok ' + response.statusText);
              }
              return response.json();
          })
          .then(data => {
              initVrTour(data);
          })
          .catch(error => {
              console.error('There has been a problem with your fetch operation:', error);
          });

      const initVrTour = (config) => {
          const vrTour = new VrTour(config.steps, config.options, configName);
          window.vrTour = vrTour;

          let url = new URL(window.location.href);
          let params = new URLSearchParams(url.search);
          let configNum = params.get('vrtour')
          if(configNum != null){
              const backLocation = params.get('origin');
              if(backLocation != null){
                  vrTour.setOrigin(backLocation);
              }
              let iframe = params.get('iframe');
              if(iframe) {
                  const body = document.querySelector('body');
                  body.classList.add('iframe-mode');
                  vrTour.iframeMode = true;
              };
              let step = params.get('step');
              if(step) {
                  step = parseInt(step);
              } else if(localStep){
                  step = parseInt(localStep);
              }
              vrTour.start(step ? step : 0);
          }

          // const haveCookie = () => {

          //       c = c.substring(1);
          //     }
          //     if (c.indexOf(name) == 0) {
          //       return true;
          //     }
          //   }
          //   document.cookie = "vrtour=true; path=/; max-age=" + 60*60*24*9999;
          //   return false;
          // }

          // if(!haveCookie()){
          //   vrTour.start();
          // }
      }
  </script>

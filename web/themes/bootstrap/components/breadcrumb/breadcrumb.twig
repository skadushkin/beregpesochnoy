{% for item in breadcrumb %}
<div class="first-crumbs-item">
    {% if item.url %}
        {% if item.url == '/' %}
            <a href="{{ item.url }}">Главная</a>
        {% else %}
            <a href="{{ item.url }}">{{ item.text }}</a>
        {% endif %}

    {% else %}
            {{ item.text }}
    {% endif %}
</div>
    {% if loop.last %}
    {% else %}
        <div class="first-crumbs-item">/</div>
    {% endif %}
{% endfor %}
